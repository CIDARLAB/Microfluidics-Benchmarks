// expression6 — five-inlet nested mix with inner sieve.
// Purpose: fold `foo` and `in1`–`in4` through nested adds, sieving the
//   innermost `in3`+`in4` pair, then drive `out`.
// Topology: foo+(in1+(in2+&(in3+in4))) → temp_out → out.
// Collaborator takeaway: `&` can wrap a sub-merge inside a larger nest.
module Expression_6(
    finput in1, in2, in3, in4, foo,  // four inlets plus `foo` feed
    foutput out                      // nested-mix product outlet
);

    flow temp_out;  // nested merge result before outlet

    // Merge: nested five-inlet tree with sieve on innermost pair
    assign temp_out = foo + (in1 + (in2 + &(in3 + in4))) ;

    // Route product to outlet
    assign out = temp_out;

endmodule
