// dropletgenerator4 — dual droplet generators sharing an oil pair.
// Purpose: Two water inlets share oilin1/oilin2; each water path is metered and merged with shared oil.
// Topology: FLOW: `waterin*` → (% drop*) → (+ oils) → `dropletout*` with shared `oilin1/2`.
// Collaborator takeaway: Per-path #CONSTRAIN can set different droplet rates.
module Droplet_Generator_4(
    finput oilin1, oilin2, waterin1, waterin2,  // FLOW inlet(s)
    foutput dropletout1, dropletout2  // FLOW outlet(s)
);
    flow drop1, drop2;  // intermediate FLOW net(s)
    #MAP "NOZZLE DROPLET GENERATOR" "%"  // tech-map: operator/keyword → component
    #CONSTRAIN "%" droplet_rate = 5 hz  // constraint on mapped operator (rate/size/etc.)
    assign drop1 = waterin1 % 100;  // meter / dropletize (FLOW)
    assign dropletout1 = drop1 + oilin1 + oilin2;  // FLOW merge / mix
    #MAP "NOZZLE DROPLET GENERATOR" "%"  // tech-map: operator/keyword → component
    #CONSTRAIN "%" droplet_rate = 6 hz  // constraint on mapped operator (rate/size/etc.)
    assign drop2 = waterin2 % 50;  // meter / dropletize (FLOW)
    assign dropletout2 = drop2 + oilin1 + oilin2;  // FLOW merge / mix
endmodule
