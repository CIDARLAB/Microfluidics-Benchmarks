// dx1 — droplet inject, incubate, and sort/discard split.
// Purpose: Meter base droplets, inject `in2`, MIXER-incubate, split kept vs discarded to two outlets.
// Topology: FLOW: `in1`% → +`in2` → ~incubate → keep/discard split → `out1`/`out2`.
// Collaborator takeaway: Discard stream is an explicit flow subtracted from the kept path.
module Dx_1(
    finput in1, in2,  // FLOW inlet(s)
    foutput out1, out2  // FLOW outlet(s)
);
    flow base_droplets, injected_droplets, incubated_droplets, sorted_droplets, discarded_droplets;  // intermediate FLOW net(s)
    assign base_droplets = in1%100;  // meter / dropletize (FLOW)
    assign injected_droplets = base_droplets + in2;  // FLOW merge / mix
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign incubated_droplets = ~injected_droplets;  // mapped unary op on FLOW (e.g. mixer/incubator)
    assign sorted_droplets = incubated_droplets - discarded_droplets;  // FLOW difference / sort peel
    assign out1 = sorted_droplets;  // continuous FLOW assign
    assign out2 = discarded_droplets;  // continuous FLOW assign
endmodule
