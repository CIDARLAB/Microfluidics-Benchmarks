// dx10 — meter+inject then keep/waste (Samuel Oliveira).
// Purpose: Meter `in1`, add `in2`, then form keep/waste via subtraction against `out2`.
// Topology: FLOW: `in1%+in2` → `temp`; `out1 = temp − out2`.
// Collaborator takeaway: Compact DropX sort idiom.
module Dx_10(
    finput in1, in2,  // FLOW inlet(s)
    foutput out1, out2  // FLOW outlet(s)
);
    flow temp;  // intermediate FLOW net(s)
    assign temp = in1 % 100 + in2;  // meter / dropletize (FLOW)
    assign out1 = temp - out2;  // FLOW difference / sort peel
endmodule
