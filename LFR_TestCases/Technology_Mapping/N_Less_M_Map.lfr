// n_l_m_map — N→M gradient expand (technology-mapping).
// Purpose: Copy 4-wide inlet, GRADIENT GENERATOR-map to 5-wide intermediate, drive outlet bus.
// Topology: FLOW: `i1[0:3]` → `temp1` → (#MAP) `temp2[0:4]` → `out[0:4]`.
// Collaborator takeaway: Tech-mapping twin of GraphCoverage/n_l_m_map.
module N_Less_M_Map(
    finput [0:3] i1,  // FLOW inlet(s)
    foutput [0:4] out  // FLOW outlet(s)
);
    flow [0:3] temp1;  // intermediate FLOW net(s)
    flow [0:4] temp2;  // intermediate FLOW net(s)
    assign temp1[0:3] = i1[0:3];  // continuous FLOW assign
    #MAP "GRADIENT GENERATOR" "assign"  // tech-map: operator/keyword → component
    assign temp2[0:4] = temp1[0:3];  // continuous FLOW assign
    assign out[0:4] = temp2[0:4];  // continuous FLOW assign
endmodule
