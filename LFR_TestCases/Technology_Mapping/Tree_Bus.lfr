// tree_bus — equal-width bus with mixer map.
// Purpose: Broadcast inlet onto a 9-wide bus, MIXER-map each lane, collapse to outlet.
// Topology: FLOW: `i1` → `temp1[0:8]` → (~ MIXER) `temp2[0:8]` → `out`.
// Collaborator takeaway: Bus replication plus per-lane mixer technology mapping.
module Tree_Bus(i1, out);
    finput i1;  // FLOW inlet(s)
    foutput out;  // FLOW outlet(s)
    flow [0:8] temp1;  // intermediate FLOW net(s)
    flow [0:8] temp2;  // intermediate FLOW net(s)
    assign temp1[0:8] = i1;  // continuous FLOW assign
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign temp2[0:8] = ~temp1[0:8];  // mapped unary op on FLOW (e.g. mixer/incubator)
    assign out = temp2[0:8];  // continuous FLOW assign
endmodule
