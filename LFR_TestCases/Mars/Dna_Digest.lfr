// dna_digest — metered digest mix with gated incubate out.
// Purpose: Meter DNA/enzyme/water into a mix, INCUBATOR-map, under `c_val` release to `a_out`.
// Topology: FLOW: metered mix → (~ INCUBATOR) → (CONTROL `c_val`) → `a_out`.
// Collaborator takeaway: Control gates product release after incubation.
module Dna_Digest(
    finput b, c, d,  // FLOW inlet(s)
    foutput a_out,  // FLOW outlet(s)
    control c_val  // CONTROL select/gate — does not carry fluid
);
    flow mixture;  // intermediate FLOW net(s)
    assign mixture = b%500 + c%500 + d%500;  // meter / dropletize (FLOW)
    flow incubator_process;  // intermediate FLOW net(s)
    #MAP "INCUBATOR" "~"  // tech-map: operator/keyword → component
    assign incubator_process = ~mixture;  // mapped unary op on FLOW (e.g. mixer/incubator)
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c_val) begin
        if (c_val == 1)  // CONTROL predicate for this FLOW arm
            a_out <= incubator_process;  // gated FLOW assign in this control arm
    end


endmodule
