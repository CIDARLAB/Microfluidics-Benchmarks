// fluorescence — toehold / trigger RNA chamber with gated mastermix.
// Purpose: Meter toehold and trigger into a chamber; under `c1` add mastermix `d`.
// Topology: FLOW: `b%+c%` → `chamber`; CONTROL `c1` may also write `d` into `chamber`.
// Collaborator takeaway: No outlet — chamber is the sink; control adds a second feed.
module Fluorescence (
    finput b, c, d,  // FLOW inlet(s)
    control c1  // CONTROL select/gate — does not carry fluid
);
    flow mixture;  // intermediate FLOW net(s)
    storage chamber;  // STORAGE / chamber node(s)
    assign mixture = b%200 + c%200;  // meter / dropletize (FLOW)
    assign chamber = mixture;  // continuous FLOW assign
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c1) begin
        if (c1 == 1)  // CONTROL predicate for this FLOW arm
            chamber <= d;  // gated FLOW assign in this control arm
    end
endmodule
