// device4_molecular_diagnostics — dual MIP-biosensor diagnostics chip.
//
// Topology (propofol joins the trunk AFTER the mixer — not a second mixer inlet):
//   gibbs_reagent → MIXER → mixed_reagent ─┐
//                                          ├─ NODE trunk_join → feed ─┬─→ sensor1 → out1
//   propofol ──────────────────────────────┘                         └─→ sensor2 ─┬─→ out2
//                                                                                  └─→ out3
//
// NODE is a temporary same-layer meet (centre hole, default radius 0). Do not
// use DIYCOMPONENT for this T-join, and do not write `gibbs + propofol` (that
// maps both ports into a MIXER).

`import "library/mip_biosensor.lfr"

module Device_4_Molecular_Diagnostics(
    finput gibbs_reagent, propofol,
    foutput out1, out2, out3
);

    flow mixed_reagent, feed;
    flow out_sensor1, out_sensor2;

    #MAP "MIXER" "~"
    assign mixed_reagent = ~gibbs_reagent;

    #MAP "NODE" "storage"
    storage trunk_join;
    assign trunk_join = mixed_reagent;
    assign trunk_join = propofol;
    assign feed = trunk_join;

    mip_biosensor #(length=8000, width=6000, height=250, componentSpacing=2000) sensor1(
        .up(out_sensor1),
        .right(None),
        .down(feed),
        .left(None)
    );

    mip_biosensor #(length=8000, width=6000, height=250, componentSpacing=2000) sensor2(
        .up(out_sensor2),
        .right(None),
        .down(feed),
        .left(None)
    );

    assign out1 = out_sensor1;
    assign out2 = out_sensor2;
    assign out3 = out_sensor2;

endmodule
