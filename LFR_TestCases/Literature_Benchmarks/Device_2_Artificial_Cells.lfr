// device2_artificial_cells — oil/reagent mix then YTREE fan-out to 8 outlets.
// Purpose: mix oil + reagent once, fan the mixed stream to eight outlets.
// Topology: p1+p2 → MIXER → YTREE trunk → out[0:7].
//
// Controls: omitted. Combining `#MAP "YTREE"` with `__ctrl_emit` into a tree
// net (or leaf) currently corrupts sizing (YTREE in=8) and adds mixer→outlet
// shortcuts. Prefer a follow-up compile fix for “valve on tree trunk” rather
// than the emit hack.
//
// Avoided anti-patterns:
// - 8× `~(p1+p2)` with one `#MAP "MIXER" "~"` → 7 unmapped `~` become
//   DROPLET CAPACITANCE SENSOR (#MAP flushes after each assign).
// - `__ctrl_emit_src = p1 + p2` → second MIXER + parallel drive.

module Device_2_Artificial_Cells(
    finput p1, p2,                   // oil + reagent / aqueous inlets
    foutput [0:7] out                // eight fan-out droplet / product outlets
);

    flow mixed;

    assign mixed = p1 + p2;

    #MAP "YTREE" "assign"
    assign out[0:7] = mixed;

endmodule
