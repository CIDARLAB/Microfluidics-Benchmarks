// device2_artificial_cells — oil/reagent droplet fan-out to 8 outlets.
// Purpose: mix oil + reagent feeds, then fan the mixed stream to p3–p10
// by repeating the shared inlet expression on each outlet (no distribute).
// route controls remain declared.
// Topology: each p3…p10 = MIXER(~) of (p1+p2); identical expression repeated 8×.
// Collaborators: no intermediate flow/storage — outlets are assigned directly.
// control route[0:2] is declared for routing valves but unused in linearized body.

module Device_2_Artificial_Cells(
    finput p1, p2,                                      // oil + reagent / aqueous inlets
    foutput p3, p4, p5, p6, p7, p8, p9, p10,            // eight fan-out droplet / product outlets
    control [0:2] route                                 // route valves (declared; unused in body)
);

    #MAP "MIXER" "~"                    // map unary ~ to MIXER (applies to following assigns)
    assign p3 = ~(p1 + p2);             // mix oil+reagent → outlet p3
    assign p4 = ~(p1 + p2);             // mix oil+reagent → outlet p4
    assign p5 = ~(p1 + p2);             // mix oil+reagent → outlet p5
    assign p6 = ~(p1 + p2);             // mix oil+reagent → outlet p6
    assign p7 = ~(p1 + p2);             // mix oil+reagent → outlet p7
    assign p8 = ~(p1 + p2);             // mix oil+reagent → outlet p8
    assign p9 = ~(p1 + p2);             // mix oil+reagent → outlet p9
    assign p10 = ~(p1 + p2);            // mix oil+reagent → outlet p10


    // CONTROL emission: declared control bits gate a flow edge (Cport–valve subnetworks)
    flow __ctrl_emit_src;
    assign __ctrl_emit_src = p1 + p2;
    distribute@(route[0]) begin
        if (route[0] == 1)
            p3 <= __ctrl_emit_src;
    end
    distribute@(route[1]) begin
        if (route[1] == 1)
            p3 <= __ctrl_emit_src;
    end
    distribute@(route[2]) begin
        if (route[2] == 1)
            p3 <= __ctrl_emit_src;
    end

endmodule
