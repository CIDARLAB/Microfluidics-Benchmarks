// device5_bacteria_diagnostics — mix + detection to one outlet.
// Purpose: combine sample/reagent inlets p1–p3 into a single product on p4.
// cp1/cp2 emit as valves on an edge from the shared merge into p4 (no second
// mix tree).
// Topology: (p1+p2)+p3 → two MIXERs → p4; CONTROL valves on merged→p4 emit.
// Do NOT re-assign `p1+p2+p3` in __ctrl_emit (that doubles the mix tree).

module Device_5_Bacteria_Diagnostics(
    finput p1, p2, p3,     // sample + two reagent / buffer inlets
    foutput p4,            // combined detection / product outlet
    control cp1, cp2       // valves on merged → p4 emit edge
);

    flow merged;
    flow __ctrl_emit_src;

    assign merged = p1 + p2 + p3;
    assign p4 = merged;

    // Alias only — no new MIX. Two distributes → two VALVE3D on merged→p4.
    assign __ctrl_emit_src = merged;
    distribute@(cp1) begin
        if (cp1 == 1)
            p4 <= __ctrl_emit_src;
    end
    distribute@(cp2) begin
        if (cp2 == 1)
            p4 <= __ctrl_emit_src;
    end

endmodule
