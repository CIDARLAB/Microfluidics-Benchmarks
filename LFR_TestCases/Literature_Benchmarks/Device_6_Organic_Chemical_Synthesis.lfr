// device6_organic_chemical_synthesis — multi-feed merge to product.
// Purpose: all reagent inlets feed one product outlet; c_mix/c_react emit as
// valves on the shared merge→product edge (CONTROL without a second 17-way mix).
// Topology: star-merge of 17 finputs → mixer tree → product; CONTROL on emit.
// Port numbering skips p7–p14 (paper IDs).

module Device_6_Organic_Chemical_Synthesis(
    finput p1, p2, p3, p4, p5, p6, p15, p16, p17, p18, p19, p20, p21, p22, p23, p24, p25,  // 17 reagent feeds
    foutput product,                // single organic synthesis product outlet
    control [0:2] c_mix,            // mix-stage valve bank on merge→product emit
    control [0:2] c_react           // react-stage valve bank on merge→product emit
);

    flow merged;
    flow __ctrl_emit_src;

    assign merged = p1 + p2 + p3 + p4 + p5 + p6
                  + p15 + p16 + p17 + p18
                  + p19 + p20 + p21 + p22 + p23 + p24 + p25;
    assign product = merged;

    // Alias only — no second 17-way MIX. Six distributes → six VALVE3D.
    assign __ctrl_emit_src = merged;
    distribute@(c_mix[0]) begin
        if (c_mix[0] == 1)
            product <= __ctrl_emit_src;
    end
    distribute@(c_mix[1]) begin
        if (c_mix[1] == 1)
            product <= __ctrl_emit_src;
    end
    distribute@(c_mix[2]) begin
        if (c_mix[2] == 1)
            product <= __ctrl_emit_src;
    end
    distribute@(c_react[0]) begin
        if (c_react[0] == 1)
            product <= __ctrl_emit_src;
    end
    distribute@(c_react[1]) begin
        if (c_react[1] == 1)
            product <= __ctrl_emit_src;
    end
    distribute@(c_react[2]) begin
        if (c_react[2] == 1)
            product <= __ctrl_emit_src;
    end

endmodule
