// distribute_network_examples — 1-to-8 mux via distribute + case.
// Purpose: Under concatenated controls `{c2,c1}`, steer one inlet onto one of eight outlets.
// Topology: FLOW: `in` → selected `out[i]`. CONTROL: 3+3-bit `{c2,c1}` decode table in `distribute`.
// Collaborator takeaway: Control word selects the active flow lane; see also one_to_8.lfr.
module Distribute_Network_Examples(finput in, foutput [0:7] out, control [0:2] c1, [0:2] c2);  // FLOW IO + CONTROL ports
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c1, c2)
    begin
        case({c2, c1})  // CONTROL value selects which FLOW arm runs
            6'b111000 :
                out[0] <= in;  // gated FLOW assign in this control arm
            6'b110001 :
                out[1] <= in;  // gated FLOW assign in this control arm
            6'b101010 :
                out[2] <= in;  // gated FLOW assign in this control arm
            6'b100011 :
                out[3] <= in;  // gated FLOW assign in this control arm
            6'b011100 :
                out[4] <= in;  // gated FLOW assign in this control arm
            6'b010101 :
                out[5] <= in;  // gated FLOW assign in this control arm
            6'b001110 :
                out[6] <= in;  // gated FLOW assign in this control arm
            6'b000111 :
                out[7] <= in;  // gated FLOW assign in this control arm
        endcase
    end


endmodule
