// multi_input — six scalar inlets merged to one outlet (test copy).
// Purpose: Linearized replacement for muxed dual-lane inlets; every inlet used.
// Topology: FLOW: `a0+a1+b0+b1+c0+c1` → `out`. CONTROLs interface-only.
// Collaborator takeaway: Test-suite twin of chthesis/multi_input.
module multi_input(
    finput a0, a1, b0, b1, c0, c1,  // FLOW inlet(s)
    foutput out,  // FLOW outlet(s)
    control s1, s2, s3  // CONTROL select/gate — does not carry fluid
);
    assign out = a0 + a1 + b0 + b1 + c0 + c1;  // FLOW merge / mix

    // CONTROL emission: declared control bits gate a flow edge (Cport–valve subnetworks)
    flow __ctrl_emit_src;
    assign __ctrl_emit_src = a0 + a1 + b0 + b1 + c0 + c1;
    distribute@(s1) begin
        if (s1 == 1)
            out <= __ctrl_emit_src;
    end
    distribute@(s2) begin
        if (s2 == 1)
            out <= __ctrl_emit_src;
    end
    distribute@(s3) begin
        if (s3 == 1)
            out <= __ctrl_emit_src;
    end

endmodule
