// issue7 — three-inlet gradient-style numeric mix to out[8:0] (GitHub #7).
// Purpose: Fully wire p, q, e onto every outlet lane using floating-literal coefficients.
// Topology: FLOW: `p,q,e` weighted mixes → `out[0]..out[8]`.
// Collaborator takeaway: Every lane must be driven to avoid floating ports.
module Issue_7(
    finput p, q, e,  // FLOW inlet(s)
    foutput [8:0] out  // FLOW outlet(s)
);
    assign out[0] = p;  // continuous FLOW assign
    assign out[1] = q;  // continuous FLOW assign
    assign out[2] = (1.0/9.0)*(5.0*p + 3.0*q + e);  // FLOW merge / mix
    assign out[3] = (5.0/84.0)*(4.0*p + 9.0*q + 2.0*e);  // FLOW merge / mix
    assign out[4] = (1.0/42.0)*(5.0*p + 20.0*q + 9.0*e);  // FLOW merge / mix
    assign out[5] = (1.0/126.0)*(6.0*p + 45.0*q + 40.0*e);  // FLOW merge / mix
    assign out[6] = (1.0/84.0)*(p + 18.0*q + 37.0*e);  // FLOW merge / mix
    assign out[7] = (1.0/12.0)*(q + 6.0*e);  // FLOW merge / mix
    assign out[8] = (1.0/3.0)*e;  // continuous FLOW assign
endmodule
