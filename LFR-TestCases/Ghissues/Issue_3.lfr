// issue3 — multi-lane IO as one connected bus (GitHub #3).
// Purpose: Four inlets all feed four outlets via shared mixer expressions.
// Topology: FLOW: each `out*` = `in0+in1+in2+in3`.
// Collaborator takeaway: Scalar IO avoids vector-slice mapping quirks that left floating PORTs.
module Issue_3(
    finput in0, in1, in2, in3,  // FLOW inlet(s)
    foutput out0, out1, out2, out3  // FLOW outlet(s)
);
    assign out0 = in0 + in1 + in2 + in3;  // FLOW merge / mix
    assign out1 = in0 + in1 + in2 + in3;  // FLOW merge / mix
    assign out2 = in0 + in1 + in2 + in3;  // FLOW merge / mix
    assign out3 = in0 + in1 + in2 + in3;  // FLOW merge / mix
endmodule
