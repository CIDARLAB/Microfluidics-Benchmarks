// dx2 — dual droplet streams merge, incubate, and discard split.
// Purpose: Meter two droplet sources, merge and MIXER-incubate, subtract discard outlet from kept.
// Topology: FLOW: `in1%`,`in2%` → merge → ~ → `out1 = incubated - out2`.
// Collaborator takeaway: Note: ports declared `foutput in1,in2` in source — preserve as-is; discard uses outlet on RHS.
module dx2(
    foutput in1, in2,  // FLOW outlet(s)
    foutput out1, out2  // FLOW outlet(s)
);
    flow droplets1, droplets2, merged_droplets, incubated_droplets;  // intermediate FLOW net(s)
    assign droplets1 = in1%100;  // meter / dropletize (FLOW)
    assign droplets2 = in2%200;  // meter / dropletize (FLOW)
    assign merged_droplets = droplets1 + droplets2;  // FLOW merge / mix
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign incubated_droplets = ~merged_droplets;  // mapped unary op on FLOW (e.g. mixer/incubator)
    assign out1 = incubated_droplets - out2;  // FLOW difference / sort peel
endmodule
