// dropx_test4 — droplet-gen / mixer maps plus weighted mix.
// Purpose: Exercise DROPLET GENERATOR and MIXER maps with size/rate constraints; also form a weighted mix.
// Topology: FLOW: mapped `&(~in1)` to `out1`, then also `0.7*in1+0.3*in2` → `out1` (second assign).
// Collaborator takeaway: Two assigns to the same outlet exercise overlay / last-writer semantics in tests.
module dropx_test4(finput in1, in2, foutput out1);  // FLOW IO ports
        #MAP "DROPLET GENERATOR" "~"  // tech-map: operator/keyword → component
        #MAP "MIXER" "&"  // tech-map: operator/keyword → component
        #CONSTRAIN "~" droplet_size = 50 um  // constraint on mapped operator (rate/size/etc.)
        #CONSTRAIN "~" generation_rate = 70 hz  // constraint on mapped operator (rate/size/etc.)
        assign out1 = &(~in1);  // mapped unary op on FLOW (e.g. mixer/incubator)
        assign out1 = in1*0.7 + in2*0.3;  // FLOW merge / mix
    endmodule
