// dx8 — multi-inlet droplet inject/mix with keep/waste (Leslie Huang).
// Purpose: Mix three inlets, meter, cascade inject in4–in6, MIXER, then peel waste/keep outlets.
// Topology: FLOW: mix → % → nested +inject → ~ → `temp−out2` → `out3=temp−out1`.
// Collaborator takeaway: Outlets appear on RHS of subtractive sort expressions.
module dx8(
    finput in1, in2, in3, in4, in5, in6,  // FLOW inlet(s)
    foutput out1, out2, out3  // FLOW outlet(s)
);
    flow in_mix;  // intermediate FLOW net(s)
    assign in_mix = in1 + in2 + in3;  // FLOW merge / mix
    flow droplets;  // intermediate FLOW net(s)
    assign droplets = in_mix % 100;  // meter / dropletize (FLOW)
    flow injected_droplets;  // intermediate FLOW net(s)
    assign injected_droplets = (in6 + (in5 + (in4 + droplets)));  // FLOW merge / mix
    flow mixed_droplets;  // intermediate FLOW net(s)
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign mixed_droplets = ~injected_droplets;  // mapped unary op on FLOW (e.g. mixer/incubator)
    flow temp;  // intermediate FLOW net(s)
    assign temp = mixed_droplets - out2;  // FLOW difference / sort peel
    assign out3 = temp - out1;  // FLOW difference / sort peel
endmodule
