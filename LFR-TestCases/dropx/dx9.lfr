// dx9 — dual meter, inject, keep/waste (David McIntyre).
// Purpose: Meter two inlets at different %, inject `in3`, subtract keep from stream to form waste.
// Topology: FLOW: `in1%+in2%` → +`in3` → `out2 = injected − out1`.
// Collaborator takeaway: Classic DropX keep/waste subtractive pair.
module dx9(
    finput in1, in2, in3,  // FLOW inlet(s)
    foutput out1, out2  // FLOW outlet(s)
);
    flow merged_droplets;  // intermediate FLOW net(s)
    assign merged_droplets = in1 % 100 + in2 % 50;  // meter / dropletize (FLOW)
    flow injected_droplets;  // intermediate FLOW net(s)
    assign injected_droplets = merged_droplets + in3;  // FLOW merge / mix
    assign out2 = injected_droplets - out1;  // FLOW difference / sort peel
endmodule
