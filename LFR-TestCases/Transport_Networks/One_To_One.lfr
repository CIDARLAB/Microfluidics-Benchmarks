// one_to_one — control-gated one-to-one transport.
// Purpose: Under `c1`, connect inlet `in` directly to outlet `out` when asserted.
// Topology: FLOW: `in` → `out` only when CONTROL `c1==1` inside `distribute`.
// Collaborator takeaway: Simplest gated transport: control enables the single flow edge.
module One_To_One(finput in, foutput out, control c1);  // FLOW IO + CONTROL ports
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c1)
    begin
        if(c1 == 1)  // CONTROL predicate for this FLOW arm
            out <= in;  // gated FLOW assign in this control arm
    end


endmodule
