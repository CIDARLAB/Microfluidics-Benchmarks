// one_to_one_mapping — pass-through with mixer map.
// Purpose: Stage a single inlet, apply MIXER (~), emit to one outlet.
// Topology: FLOW: `in` → `temp1` → (~ MIXER) `temp2` → `out`.
// Collaborator takeaway: One-to-one connectivity plus a single technology map.
module one_to_one_mapping(in, out);
    finput in;  // FLOW inlet(s)
    foutput out;  // FLOW outlet(s)
    flow temp1;  // intermediate FLOW net(s)
    flow temp2;  // intermediate FLOW net(s)
    assign temp1 = in;  // continuous FLOW assign
    #MAP  "MIXER" "~"  // tech-map: operator/keyword → component
    assign temp2 = ~temp1;  // mapped unary op on FLOW (e.g. mixer/incubator)
    assign out = temp2;  // continuous FLOW assign
endmodule
