// directed_evolution — PCR / TX-TL / wash linearized to shared product.
// Purpose: merge genes + PCR mastermix + TX-TL + ethanol, then drive
// result / waste1 / waste2 / candidate storage from that shared inlet
// expression (no distribute). Process maps applied on a parallel stage
// that reuses the same inlet ports so FLOW stays one island.
// Topology: all inlets → stage (& Incubate) in parallel with result/waste/candidate assigns.
// Collaborators: controls declared for selection logic but unused in linearized body.
// Repeated inlet expression on each assign keeps every PORT on one continuous graph.

module directed_evolution(
    finput genes, pcr_mastermix, tx_tl_sol, ethanol,   // genes, PCR mix, TX-TL, wash ethanol
    foutput result, waste1, waste2,                    // product + dual waste outlets
    control initial, found_candidate, found_result     // selection controls (declared; unused)
);

    flow stage;                                        // incubated process stage stream
    storage candidate_pool;                            // candidate library holding storage

    #MAP "Incubate" "&"                                // map unary & to Incubate process
    assign stage = &(genes + pcr_mastermix + tx_tl_sol + ethanol);  // incubate merged reagents

    assign result = genes + pcr_mastermix + tx_tl_sol + ethanol;           // product from shared merge
    assign waste1 = genes + pcr_mastermix + tx_tl_sol + ethanol;           // waste1 from shared merge
    assign waste2 = genes + pcr_mastermix + tx_tl_sol + ethanol;           // waste2 from shared merge
    assign candidate_pool = genes + pcr_mastermix + tx_tl_sol + ethanol;  // candidates from shared merge

endmodule
