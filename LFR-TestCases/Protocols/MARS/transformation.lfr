// transformation — MARS plasmid / cell transformation.
// Purpose: meter plasmid into cells, sieve-mix the reaction, incubate
// (hybrid store/process with delay), and emit `result`.
// Topology: plasmid%50.88 → + cell%50 → &reaction_mix → INCUBATOR → result.
// Collaborators: unary & on reaction_mix models process delay (~1 hour) before storage incubate.
// Metering volumes 50.88 (plasmid) and 50 (cells) follow the MARS protocol recipe.

module transformation(finput plasmid, cell_suspension, foutput result);  // plasmid + cells in → transformants out

    flow reaction_mix, plasmid_vol;                     // metered plasmid + combined reaction mix
    storage incubator;                                  // transformation incubator (hybrid store/process)

//  This is the metering network should we manually map it ?
    assign plasmid_vol = plasmid % 50.88;               // meter plasmid volume (50.88)

    assign reaction_mix = plasmid_vol + cell_suspension % 50;  // merge plasmid with metered cells (vol 50)

//  This is sort of a hybrid store and process system so it
//  also has a delay associated with it
//  Delay 1 hour

    #MAP "INCUBATOR" "storage"                          // map storage type to INCUBATOR process
    assign incubator = &reaction_mix;                   // incubate reaction_mix (unary & = delay/process)
    assign result = incubator;                          // emit incubated transformation product

endmodule
