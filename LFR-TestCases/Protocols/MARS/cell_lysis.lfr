// cell_lysis — MARS lysis / neutralization / elution (linearized).
// Purpose: all four buffers/cells feed the single result outlet so the
// compiled device is one connected component.
// Topology: star merge lysing_buffer + suspended_cells + neutralization + elution → result.
// Collaborators: MARS protocol step; linearized from sequenced lysis → neutralize → elute.
// No storage or MAP — single continuous assign path for connectivity testing.

module cell_lysis(
    finput lysing_buffer, suspended_cells, neutralization_buffer, elution_buffer,  // lysis protocol reagents
    foutput result                                                                  // combined lysis product outlet
);

    // Merge all lysis / neutralization / elution inputs onto result.
    assign result = lysing_buffer + suspended_cells + neutralization_buffer + elution_buffer;

endmodule
