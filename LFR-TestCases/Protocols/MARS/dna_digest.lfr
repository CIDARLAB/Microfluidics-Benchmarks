// dna_digest — MARS restriction digest with incubate / punch.
// Purpose: meter DNA suspension and enzyme buffer, mix into a digestion
// volume, incubate (storage map), then combine with water in a punch chamber.
// Topology: dna%50 + buffer%50 → digestion_mix → INCUBATOR → + water → PUNCH CHAMBER (result).
// Collaborators: ports also listed in the module arg list before finput decls (legacy style — keep).
// Dual MAP stages: INCUBATOR for digest hold, PUNCH CHAMBER for final water combine.

module dna_digest(dna_suspension, buffer_enzyme_solution, water);  // legacy port list (names match finputs)

    finput dna_suspension, buffer_enzyme_solution, water;          // DNA, enzyme buffer, and dilution water
    storage result, incubation_mix;                                // punch-chamber result + incubation storage

    flow dna_suspension_vol, buffer_enzyme_solution_vol, digestion_mix;  // metered volumes + digest mix

    assign dna_suspension_vol = dna_suspension % 50;                        // meter DNA suspension (vol 50)
    assign buffer_enzyme_solution_vol = buffer_enzyme_solution % 50;        // meter enzyme buffer (vol 50)
    assign digestion_mix = dna_suspension_vol + buffer_enzyme_solution_vol; // combine into digestion mix
    
    #MAP "INCUBATOR" "storage"                      // map storage type to INCUBATOR process
// This should be a storing statement
    assign incubation_mix = digestion_mix;          // load incubation storage from digestion mix

// Delay for 1 hour
// This is also storage
    #MAP "PUNCH CHAMBER" "storage"                  // map storage type to PUNCH CHAMBER process
    assign result = incubation_mix + water;         // combine incubated digest with water in punch chamber

endmodule
