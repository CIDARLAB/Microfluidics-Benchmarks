// pcr — control-gated PCR mix and incubate.
// Purpose: Load PCR solution, mix and incubate, release product to `a_out`.
// Topology: FLOW: `a` → mix(+) → incubate(~) → `a_out`. CONTROL: `c1`,`c2` gate emission edges.
// Collaborator takeaway: #MAP binds `+`/`~` to MIX/Incubator; controls emit as Cports.
module pcr(
    finput a,  // FLOW inlet(s)
    foutput a_out,  // FLOW outlet(s)
    control c1, c2  // CONTROL select/gate — does not carry fluid
);
    flow mixer_in, mixed, incubated;  // intermediate FLOW net(s)
    #MAP "MIX" "+"  // tech-map: operator/keyword → component
    #MAP "Incubator" "~"  // tech-map: operator/keyword → component
    assign mixer_in = a;  // continuous FLOW assign
    assign mixed = +mixer_in;  // mapped unary/binary op on FLOW
    assign incubated = ~mixed;  // mapped unary op on FLOW

    // CONTROL emission: declared control bits gate a flow edge (Cport–valve subnetworks)
    flow __ctrl_emit_src;
    assign __ctrl_emit_src = incubated;
    distribute@(c1) begin
        if (c1 == 1)
            a_out <= __ctrl_emit_src;
    end
    distribute@(c2) begin
        if (c2 == 1)
            a_out <= __ctrl_emit_src;
    end

endmodule
