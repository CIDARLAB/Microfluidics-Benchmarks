// ligation — MARS multi-reagent DNA ligation.
// Purpose: sequentially meter and mix ligase buffer, vector, insert, water,
// and ligase; incubate the five-input mix and emit `result`.
// Topology: sequential %50 metering chain → temp1…temp4 → INCUBATOR(temp5) → result.
// Collaborators: nfwater is nuclease-free water; 5-input mix is built as a linear tree.
// #MAP remaps storage temp5 to an INCUBATOR process for the ligation incubation.

module ligation(finput ligase_buffer, vector_dna, insert_dna,
    nfwater, ligase, foutput result);                   // five ligation reagents in → result out

    flow temp1, temp2, temp3, temp4;                    // sequential metering / mix intermediates
    storage temp5;                                      // incubation storage (mapped to INCUBATOR)

// This should probably generate a 5 input mixing tree as an alternative    
    assign temp1 = ligase_buffer % 50;                  // meter ligase buffer (vol 50)
    assign temp2 = vector_dna % 50 + temp1;             // meter vector DNA and merge with temp1
    assign temp3 = insert_dna % 50 + temp2;             // meter insert DNA and merge with temp2
    assign temp4 = nfwater % 50 + temp3;                // meter NF water and merge with temp3
    
    #MAP "INCUBATOR" "storage"                          // map storage type to INCUBATOR process
    assign temp5 = temp4 + ligase % 50;                 // meter ligase, merge, and incubate
    assign result = temp5;                              // emit incubated ligation product

endmodule
