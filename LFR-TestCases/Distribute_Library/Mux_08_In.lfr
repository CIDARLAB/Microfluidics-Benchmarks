// mux_08_in — 1-to-8 demultiplexer (library primitive).
// Purpose: Under 3-bit control `c_select`, steer a single flow inlet onto one of eight outlet lanes (despite the `_in` name, topology is 1→8).
// Topology: FLOW: `input` → selected `outputs[i]`. CONTROL: `c_select` chooses the active lane inside `distribute`.
// Collaborator takeaway: Named `_in` historically but behaves as a demux: one flow in, many flow outs, control steers.
module Mux_08_In(
    finput input,  // FLOW inlet(s)
    foutput [0:7] outputs,  // FLOW outlet(s)
    control [0:2] c_select  // CONTROL select/gate — does not carry fluid
);
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c_select)
    begin
        case(c_select)  // CONTROL value selects which FLOW arm runs
            3'b000 : outputs[0] <= input;  // FLOW edge enabled in this control arm
            3'b001 : outputs[1] <= input;  // FLOW edge enabled in this control arm
            3'b010 : outputs[2] <= input;  // FLOW edge enabled in this control arm
            3'b011 : outputs[3] <= input;  // FLOW edge enabled in this control arm
            3'b100 : outputs[4] <= input;  // FLOW edge enabled in this control arm
            3'b101 : outputs[5] <= input;  // FLOW edge enabled in this control arm
            3'b110 : outputs[6] <= input;  // FLOW edge enabled in this control arm
            3'b111 : outputs[7] <= input;  // FLOW edge enabled in this control arm
        endcase
    end


endmodule
