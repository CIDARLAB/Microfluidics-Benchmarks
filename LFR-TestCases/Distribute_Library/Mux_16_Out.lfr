// mux_16_out — 1-to-16 demultiplexer (library primitive).
// Purpose: Under 4-bit control `c_select`, steer a single flow inlet onto one of sixteen outlet lanes.
// Topology: FLOW: `input` → selected `outputs[i]`. CONTROL: `c_select` chooses the active lane inside `distribute`/`case`.
// Collaborator takeaway: Control picks the lane; only flow ports carry fluid. Inactive outlets are not driven in that arm.
module Mux_16_Out(
    finput input,  // FLOW inlet(s)
    foutput [0:15] outputs,  // FLOW outlet(s)
    control [0:3] c_select  // CONTROL select/gate — does not carry fluid
);
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c_select)
    begin
        case(c_select)  // CONTROL value selects which FLOW arm runs
            4'b0000 : outputs[0] <= input;  // FLOW edge enabled in this control arm
            4'b0001 : outputs[1] <= input;  // FLOW edge enabled in this control arm
            4'b0010 : outputs[2] <= input;  // FLOW edge enabled in this control arm
            4'b0011 : outputs[3] <= input;  // FLOW edge enabled in this control arm
            4'b0100 : outputs[4] <= input;  // FLOW edge enabled in this control arm
            4'b0101 : outputs[5] <= input;  // FLOW edge enabled in this control arm
            4'b0110 : outputs[6] <= input;  // FLOW edge enabled in this control arm
            4'b0111 : outputs[7] <= input;  // FLOW edge enabled in this control arm
            4'b1000 : outputs[8] <= input;  // FLOW edge enabled in this control arm
            4'b1001 : outputs[9] <= input;  // FLOW edge enabled in this control arm
            4'b1010 : outputs[10] <= input;  // FLOW edge enabled in this control arm
            4'b1011 : outputs[11] <= input;  // FLOW edge enabled in this control arm
            4'b1100 : outputs[12] <= input;  // FLOW edge enabled in this control arm
            4'b1101 : outputs[13] <= input;  // FLOW edge enabled in this control arm
            4'b1110 : outputs[14] <= input;  // FLOW edge enabled in this control arm
            4'b1111 : outputs[15] <= input;  // FLOW edge enabled in this control arm
        endcase
    end


endmodule
