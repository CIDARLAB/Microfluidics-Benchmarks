// v0 — HMLP-style dual banks with wash/media/cells (linearized).
// Purpose: All bank lanes, wash, media, and cells feed both outlets via shared expressions.
// Topology: FLOW: banks+wash+media+cells → `out0` and `out1`. CONTROLs interface-only.
// Collaborator takeaway: Linearized HMLP so the netlist is one connected component.
module v0(
    finput a0, a1, a2, a3, b0, b1, b2, b3, wash, media, cells,  // FLOW inlet(s)
    foutput out0, out1,  // FLOW outlet(s)
    control [0:1] c_inputs1, [0:1] c_inputs2, c_wash, [0:1] c_media  // CONTROL select/gate — does not carry fluid
);
    assign out0 = a0 + a1 + a2 + a3 + b0 + b1 + b2 + b3 + wash + media + cells;  // FLOW merge / mix
    assign out1 = a0 + a1 + a2 + a3 + b0 + b1 + b2 + b3 + wash + media + cells;  // FLOW merge / mix
endmodule
