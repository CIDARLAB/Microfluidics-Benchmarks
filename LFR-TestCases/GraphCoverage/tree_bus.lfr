// tree_bus — scalar-to-vector bus replication (graph-coverage).
// Purpose: Broadcast inlet onto a 9-wide bus, copy through a second bus, collapse to outlet.
// Topology: FLOW: `i1` → `temp1[0:8]` → `temp2[0:8]` → `out`.
// Collaborator takeaway: Equal-width vector buses are the safe bus-replication pattern.
module tree_bus(i1, out);
    finput i1;  // FLOW inlet(s)
    foutput out;  // FLOW outlet(s)
    flow [0:8] temp1;  // intermediate FLOW net(s)
    flow [0:8] temp2;  // intermediate FLOW net(s)
    assign temp1[0:8] = i1;  // continuous FLOW assign
    assign temp2[0:8] = temp1[0:8];  // continuous FLOW assign
    assign out = temp2[0:8];  // continuous FLOW assign
endmodule
