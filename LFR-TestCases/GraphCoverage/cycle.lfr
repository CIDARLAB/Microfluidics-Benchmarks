// cycle — three-inlet merge to one outlet (graph-coverage).
// Purpose: Cover merge connectivity; true feedback cycles do not emit channels in this mapper.
// Topology: FLOW: `input1+input2+input3` → `out`.
// Collaborator takeaway: Use a merge stand-in when testing 'cycle' coverage without floating ports.
module cycle(
    finput input1, input2, input3,  // FLOW inlet(s)
    foutput out  // FLOW outlet(s)
);
    assign out = input1 + input2 + input3;  // FLOW merge / mix
endmodule
