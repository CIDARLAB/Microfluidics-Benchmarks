// ring — three-inlet merge to one outlet (linearized recirculation).
// Purpose: Feedback cycles do not emit channels in the current mapper; use a merge stand-in.
// Topology: FLOW: `input1+input2+input3` → `out`.
// Collaborator takeaway: Same connectivity lesson as cycle.lfr.
module Ring(
    finput input1, input2, input3,  // FLOW inlet(s)
    foutput out  // FLOW outlet(s)
);
    assign out = input1 + input2 + input3;  // FLOW merge / mix
endmodule
