// seeding
// Purpose: microfluidic cell-seeding / chemotaxis chip
// (Wang / Bergmann / Lin / Kim / Levchenko, Sci. Signaling 2012).
// Buffer and stimuli fill culture storage that fans to seeding_out
// and waste via fully wired buses.
// Topology: buffer+stimuli → culture → {seeding_bank → seeding_out, waste_bank → waste}.
// Collaborators: control[6:0] is declared for valving but unused in this linearized body.
// Parallel storage banks keep both outlets on the culture island without distribute.

module Seeding(
    control [6:0] c,                 // valve control bus (declared; unused in body)
    finput buffer, stimuli,          // culture buffer + chemotactic stimuli inlets
    foutput seeding_out, waste       // seeded culture outlet + waste drain
);

    storage culture;                           // shared culture / holding chamber
    assign culture = buffer + stimuli;         // merge buffer and stimuli into culture

    storage [0:7] seeding_bank;                // 8-chamber bank feeding the seeding outlet
    assign seeding_bank = culture;             // fan culture into seeding bank
    assign seeding_out = seeding_bank;         // collect seeding bank to seeding_out

    storage [0:7] waste_bank;                  // 8-chamber bank feeding waste
    assign waste_bank = culture;               // fan culture into waste bank
    assign waste = waste_bank;                 // collect waste bank to waste


    // CONTROL emission: declared control bits gate a flow edge (Cport–valve subnetworks)
    flow __ctrl_emit_src;
    assign __ctrl_emit_src = buffer + stimuli;
    distribute@(c[0]) begin
        if (c[0] == 1)
            seeding_out <= __ctrl_emit_src;
    end
    distribute@(c[1]) begin
        if (c[1] == 1)
            seeding_out <= __ctrl_emit_src;
    end
    distribute@(c[2]) begin
        if (c[2] == 1)
            seeding_out <= __ctrl_emit_src;
    end
    distribute@(c[3]) begin
        if (c[3] == 1)
            seeding_out <= __ctrl_emit_src;
    end
    distribute@(c[4]) begin
        if (c[4] == 1)
            seeding_out <= __ctrl_emit_src;
    end
    distribute@(c[5]) begin
        if (c[5] == 1)
            seeding_out <= __ctrl_emit_src;
    end
    distribute@(c[6]) begin
        if (c[6] == 1)
            seeding_out <= __ctrl_emit_src;
    end

endmodule
