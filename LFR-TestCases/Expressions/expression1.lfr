// expression1 — dual metering (% droplet generators) then merge.
// Purpose: meter two inlets independently with DROPLET GENERATOR maps,
//   then combine the products into a single outlet.
// Topology: in1 % 50.88 → drop1 ┐
//           in2 % 100   → drop2 ┴→ merged → out.
// Collaborator takeaway: unique intermediates avoid double-assign on any LHS.
module expression1(
    finput in1, in2,  // two fluid inlets to meter
    foutput out       // merged droplet product outlet
);

    flow drop1, drop2, merged;  // metered lanes and their merge result

    #MAP "NOZZLE DROPLET GENERATOR" "%"  // map % to DROPLET GENERATOR
    // Meter: generate droplets from in1 at volume 50.88
    assign drop1 = in1 % 50.88;

    #MAP "NOZZLE DROPLET GENERATOR" "%"  // map % to DROPLET GENERATOR
    // Meter: generate droplets from in2 at volume 100
    assign drop2 = in2 % 100;

    // Merge: combine both metered streams
    assign merged = drop1 + drop2;
    // Route merged product to outlet
    assign out = merged;

endmodule
