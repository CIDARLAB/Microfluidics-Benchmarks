// expression2 — mix plus metered second inlet.
// Purpose: combine `in1` with a %-metered portion of `in2` and route the
//   result to `out`.
// Topology: in1 + (in2 % 50) → temp_out → out.
// Collaborator takeaway: `%` metering nests inside a merge expression.
module expression2(
    finput in1, in2,  // primary inlet and inlet to meter
    foutput out       // mixed product outlet
);

    flow temp_out;  // merge result before outlet

    // Merge: full in1 plus metered portion of in2
    assign temp_out = in1 + in2 % 50;

    // Route product to outlet
    assign out = temp_out;

endmodule
