// tdroplet — dual-lane droplet metering, mix/delay, trap select.
// Purpose: Meter both inlet lanes, MIXER-delay, then control-select one lane into a long cell trap to `output`.
// Topology: FLOW: `inputs` → (% DROPLET) `temp_inputs` → (~ MIXER) `delayed` → (CONTROL `c_select`) `cell_trap` → `output`.
// Collaborator takeaway: Control selects which delayed lane enters the trap; flow carries droplets.
module tdroplet(
    finput [0:1] inputs,  // FLOW inlet(s)
    foutput output,  // FLOW outlet(s)
    control c_select  // CONTROL select/gate — does not carry fluid
);
    flow [0:1] temp_inputs;  // intermediate FLOW net(s)
    flow [0:1] delayed_outputs;  // intermediate FLOW net(s)
    flow trapped;  // intermediate FLOW net(s)
    #MAP "NOZZLE DROPLET GENERATOR" "%"  // tech-map: operator/keyword → component
    assign temp_inputs = inputs % 50;  // meter / dropletize (FLOW)
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign delayed_outputs = ~temp_inputs;  // mapped unary op on FLOW (e.g. mixer/incubator)
    #MAP "LONG CELL TRAP" "storage"  // tech-map: operator/keyword → component
    storage cell_trap;  // STORAGE / chamber node(s)
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c_select)
    begin
        if (c_select == 1'b1)  // CONTROL predicate for this FLOW arm
            cell_trap <= delayed_outputs[0];  // FLOW edge enabled in this control arm
        else  // alternate CONTROL arm
            cell_trap <= delayed_outputs[1];  // FLOW edge enabled in this control arm
    end
    assign trapped = cell_trap;  // continuous FLOW assign
    assign output = trapped;  // continuous FLOW assign


endmodule
