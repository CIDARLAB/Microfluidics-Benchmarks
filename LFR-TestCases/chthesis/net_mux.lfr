// net_mux — dual-inlet fan-out device with a combined product outlet.
// Purpose: three inlets merge; the product is mirrored to eight fan-out
//   outlets plus `out2`, keeping one connected netlist (LFR PORT count =
//   MINT PORT count = 12).
// Topology: FLOW: in1,in2a,in2b → (o0..o7, out2). CONTROL: interface-only.
// Collaborator takeaway: Prefer driving outlets directly from shared inlet
//   expressions; unused `storage` nodes become floating components in MINT.
module net_mux(
    finput in1, in2a, in2b,                          // three FLOW inlets
    foutput o0, o1, o2, o3, o4, o5, o6, o7, out2,    // eight fan-outs + product
    control c_in1, c_in2, c_in_connect, c_out_connect, c_out1  // interface-only
);

    // Each outlet reuses all three inlets → single connected island
    assign o0 = in1 + in2a + in2b;
    assign o1 = in1 + in2a + in2b;
    assign o2 = in1 + in2a + in2b;
    assign o3 = in1 + in2a + in2b;
    assign o4 = in1 + in2a + in2b;
    assign o5 = in1 + in2a + in2b;
    assign o6 = in1 + in2a + in2b;
    assign o7 = in1 + in2a + in2b;
    assign out2 = in1 + in2a + in2b;


    // CONTROL emission: declared control bits gate a flow edge (Cport–valve subnetworks)
    flow __ctrl_emit_src;
    assign __ctrl_emit_src = in1 + in2a + in2b;
    distribute@(c_in1) begin
        if (c_in1 == 1)
            o0 <= __ctrl_emit_src;
    end
    distribute@(c_in2) begin
        if (c_in2 == 1)
            o0 <= __ctrl_emit_src;
    end
    distribute@(c_in_connect) begin
        if (c_in_connect == 1)
            o0 <= __ctrl_emit_src;
    end
    distribute@(c_out_connect) begin
        if (c_out_connect == 1)
            o0 <= __ctrl_emit_src;
    end
    distribute@(c_out1) begin
        if (c_out1 == 1)
            o0 <= __ctrl_emit_src;
    end

endmodule
