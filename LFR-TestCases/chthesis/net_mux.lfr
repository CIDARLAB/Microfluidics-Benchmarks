// net_mux — dual-inlet cell-trap array fanning to dual outlets.
// Purpose: Merge in1 with both in2 lanes into traps; YTREE-fan in1 to out1; drive out2 from shared merge.
// Topology: FLOW: `in1,in2[*]` → `cell_traps`; `in1` → (#MAP YTREE) `out1[0:7]`; merge → `out2`. CONTROLs interface-only.
// Collaborator takeaway: Linearized net-mux: no distribute, all ports on one island.
module net_mux(
    finput in1, [0:1] in2,  // FLOW inlet(s)
    foutput [0:7] out1, out2,  // FLOW outlet(s)
    control c_in1, c_in2, c_in_connect, c_out_connect, c_out1  // CONTROL select/gate — does not carry fluid
);
    flow in2_0, in2_1;  // intermediate FLOW net(s)
    storage [0:7] cell_traps;  // STORAGE / chamber node(s)
    assign in2_0 = in2[0];  // continuous FLOW assign
    assign in2_1 = in2[1];  // continuous FLOW assign
    assign cell_traps = in1 + in2_0 + in2_1;  // FLOW merge / mix
    #MAP "YTREE" "assign"  // tech-map: operator/keyword → component
    assign out1[0:7] = in1;  // continuous FLOW assign
    assign out2 = in1 + in2_0 + in2_1;  // FLOW merge / mix
endmodule
