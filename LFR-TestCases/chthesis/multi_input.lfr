// multi_input — six scalar inlets merged to one outlet.
// Purpose: Linearized replacement for muxed dual-lane inlets; every inlet used in the outlet expression.
// Topology: FLOW: `a0+a1+b0+b1+c0+c1` → `out`. CONTROL: `s1,s2,s3` interface-only.
// Collaborator takeaway: Keep unused-looking controls if the original mux interface still matters.
module multi_input(
    finput a0, a1, b0, b1, c0, c1,  // FLOW inlet(s)
    foutput out,  // FLOW outlet(s)
    control s1, s2, s3  // CONTROL select/gate — does not carry fluid
);
    assign out = a0 + a1 + b0 + b1 + c0 + c1;  // FLOW merge / mix
endmodule
