// rotary_cells — 4-inlet rotary mix into cell traps (linearized).
// Purpose: Merge all inlets into four traps and tree-reduce to one outlet.
// Topology: FLOW: `in_1[*]` → `i*` → `cell_traps[0:3]` → `out_1`. CONTROLs interface-only.
// Collaborator takeaway: Rotary map omitted so traps stay on the inlet island.
module rotary_cells(
    finput [0:3] in_1,  // FLOW inlet(s)
    foutput out_1,  // FLOW outlet(s)
    control [0:1] c_inputs, [0:1] c_cell_traps  // CONTROL select/gate — does not carry fluid
);
    flow i0, i1, i2, i3;  // intermediate FLOW net(s)
    storage [0:3] cell_traps;  // STORAGE / chamber node(s)
    assign i0 = in_1[0];  // continuous FLOW assign
    assign i1 = in_1[1];  // continuous FLOW assign
    assign i2 = in_1[2];  // continuous FLOW assign
    assign i3 = in_1[3];  // continuous FLOW assign
    assign cell_traps = i0 + i1 + i2 + i3;  // FLOW merge / mix
    assign out_1 = cell_traps;  // continuous FLOW assign
endmodule
