// rotary16 — 16-wide bank rotary mix (linearized).
// Purpose: Merge all bank inlets on a hub, then YTREE-fan from `bank_in[0]` onto every bank outlet.
// Topology: FLOW: `bank_in[*]` → `b*` → `hub`; `bank_in[0]` → (#MAP YTREE) `bank_out[0:15]`. CONTROLs interface-only.
// Collaborator takeaway: Mux-library imports dropped so the netlist stays one connected component.
module rotary16(
    finput [0:15] bank_in,  // FLOW inlet(s)
    foutput [0:15] bank_out,  // FLOW outlet(s)
    control [0:3] c_in, [0:3] c_out  // CONTROL select/gate — does not carry fluid
);
    flow b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, hub;  // intermediate FLOW net(s)
    assign b0 = bank_in[0];  // continuous FLOW assign
    assign b1 = bank_in[1];  // continuous FLOW assign
    assign b2 = bank_in[2];  // continuous FLOW assign
    assign b3 = bank_in[3];  // continuous FLOW assign
    assign b4 = bank_in[4];  // continuous FLOW assign
    assign b5 = bank_in[5];  // continuous FLOW assign
    assign b6 = bank_in[6];  // continuous FLOW assign
    assign b7 = bank_in[7];  // continuous FLOW assign
    assign b8 = bank_in[8];  // continuous FLOW assign
    assign b9 = bank_in[9];  // continuous FLOW assign
    assign b10 = bank_in[10];  // continuous FLOW assign
    assign b11 = bank_in[11];  // continuous FLOW assign
    assign b12 = bank_in[12];  // continuous FLOW assign
    assign b13 = bank_in[13];  // continuous FLOW assign
    assign b14 = bank_in[14];  // continuous FLOW assign
    assign b15 = bank_in[15];  // continuous FLOW assign
    assign hub = b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7  // FLOW merge / mix
               + b8 + b9 + b10 + b11 + b12 + b13 + b14 + b15;
    #MAP "YTREE" "assign"  // tech-map: operator/keyword → component
    assign bank_out[0:15] = bank_in[0];  // continuous FLOW assign
endmodule
