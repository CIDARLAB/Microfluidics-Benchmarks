// dropletgenerator — single-inlet droplet generator.
// Purpose: Map DROPLET GENERATOR (%) on `waterin` (constrained rate) and emit metered droplets at `dropletout`.
// Topology: FLOW: `waterin` → (% metered) `dropletout`. #CONSTRAIN sets generation rate.
// Collaborator takeaway: #MAP binds `%` to DROPLET GENERATOR; #CONSTRAIN sets operating rate.
module dropletgenerator(waterin, dropletout);
    finput waterin;  // FLOW inlet(s)
    foutput dropletout;  // FLOW outlet(s)
    #MAP "DROPLET GENERATOR" "%"  // tech-map: operator/keyword → component
    #CONSTRAIN "&" droplet_rate = 30 hz  // constraint on mapped operator (rate/size/etc.)
    assign dropletout = waterin%100 ;  // meter / dropletize (FLOW)
endmodule
