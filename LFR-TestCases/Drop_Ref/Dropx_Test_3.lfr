// dropx_test3 — dual metered inlets into storage then merge.
// Purpose: Meter two inlets into storage nodes, then merge storages to one outlet.
// Topology: FLOW: `in1`,`in2` → (% → storage) → sum → `out1`.
// Collaborator takeaway: Storage-typed metering intermediates (synthesizable variant of test2).
module Dropx_Test_3(finput in1, in2, foutput out1);  // FLOW IO ports
    storage in1_metered, in2_metered;  // STORAGE / chamber node(s)
    #CONSTRAIN "%" generation_rate = 400 hz  // constraint on mapped operator (rate/size/etc.)
    assign in1_metered = in1%0.1;  // meter / dropletize (FLOW)
    #CONSTRAIN "%" generation_rate = 400 hz  // constraint on mapped operator (rate/size/etc.)
    assign in2_metered = in2%0.1;  // meter / dropletize (FLOW)
    assign out1 = in1_metered + in2_metered;  // FLOW merge / mix
endmodule
