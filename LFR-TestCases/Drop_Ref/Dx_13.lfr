// dx13 — multi-stage inject/sort/split (Diana Arguijo).
// Purpose: Meter, incubate, pico-inject, sort, reinject, incubate, sort, then 1:1 split to four outs.
// Topology: FLOW: long pipeline ending in `{splitter_1,splitter_2}=sorted_2/2` plus trash outs.
// Collaborator takeaway: Richest DropX cascade in this suite.
module Dx_13(
    finput in1, in2, in3,  // FLOW inlet(s)
    foutput out1, out2, out3, out4  // FLOW outlet(s)
);
    flow droplets_1, mix_1, pico_1, mix_2, sorted_trash_1, sorted_1, pico_2, mix_3, sorted_trash_2, sorted_2, splitter_1, splitter_2;  // intermediate FLOW net(s)
    assign droplets_1 = in1%100;  // meter / dropletize (FLOW)
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign mix_1 = ~droplets_1;  // mapped unary op on FLOW (e.g. mixer/incubator)
    assign pico_1 = mix_1 + in2;  // FLOW merge / mix
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign mix_2 = ~pico_1;  // mapped unary op on FLOW (e.g. mixer/incubator)
    assign sorted_1 = mix_2 - sorted_trash_1;  // FLOW difference / sort peel
    assign pico_2 = sorted_1 + in3;  // FLOW merge / mix
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign mix_3 = ~pico_2;  // mapped unary op on FLOW (e.g. mixer/incubator)
    assign sorted_2 = mix_3 - sorted_trash_2;  // FLOW difference / sort peel
    assign {splitter_1, splitter_2} = sorted_2/2;  // equal FLOW split into parts
    assign out1 = sorted_trash_1;  // continuous FLOW assign
    assign out2 = sorted_trash_2;  // continuous FLOW assign
    assign out3 = splitter_1;  // continuous FLOW assign
    assign out4 = splitter_2;  // continuous FLOW assign
endmodule
