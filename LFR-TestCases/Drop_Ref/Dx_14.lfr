// dx14 — DropX-style mix to keep/waste (Ali Lashkaripour).
// Purpose: Three inlets merge; keep and waste both reuse the same inlet PORTs (one island).
// Topology: FLOW: `in1+in2+in3` → both `keep` and `waste`.
// Collaborator takeaway: Linearized keep/waste when subtractive sort would float ports.
module Dx_14(
    finput in1, in2, in3,  // FLOW inlet(s)
    foutput waste, keep  // FLOW outlet(s)
);
    assign keep = in1 + in2 + in3;  // FLOW merge / mix
    assign waste = in1 + in2 + in3;  // FLOW merge / mix
endmodule
