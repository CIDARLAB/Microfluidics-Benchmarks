// dx5 — inject, split, incubate, and dual keep/waste.
// Purpose: Inject `in2` into metered `in1`, split 1:1, MIXER each half, subtract waste lanes.
// Topology: FLOW: inject → /2 → (~ MIXER − waste) → `sort_keep*`.
// Collaborator takeaway: Per-lane mixer map after the split.
module Dx_5 (
    finput in1, in2,  // FLOW inlet(s)
    foutput sort_keep1, sort_keep2, sort_waste1, sort_waste2  // FLOW outlet(s)
);
    flow injected_droplets;  // intermediate FLOW net(s)
    assign injected_droplets = in2 + in1%100;  // meter / dropletize (FLOW)
    flow split1, split2;  // intermediate FLOW net(s)
    assign {split1, split2} = injected_droplets/2;  // equal FLOW split into parts
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign sort_keep1 = ~split1 - sort_waste1;  // mapped unary op on FLOW (e.g. mixer/incubator)
    #MAP "MIXER" "~"  // tech-map: operator/keyword → component
    assign sort_keep2 = ~split2 - sort_waste2;  // mapped unary op on FLOW (e.g. mixer/incubator)
endmodule
