// device6_organic_chemical_synthesis — multi-feed merge to product.
// Purpose: all reagent inlets feed one product outlet. Linearized from
// concentration/reaction distribute loops so the netlist is one island.
// Topology: star merge of 17 finputs (p1–p6, p15–p25) → product.
// Collaborators: port numbering skips p7–p14 (paper IDs); c_mix/c_react unused here.
// Controls remain declared for mix/react valve banks from the original distribute form.

module device6_organic_chemical_synthesis(
    finput p1, p2, p3, p4, p5, p6, p15, p16, p17, p18, p19, p20, p21, p22, p23, p24, p25,  // 17 reagent feeds
    foutput product,                // single organic synthesis product outlet
    control [0:2] c_mix,            // mix-stage valve bank (declared; unused in linearized body)
    control [0:2] c_react           // react-stage valve bank (declared; unused in linearized body)
);

    // Collapse every reagent inlet onto the product (linearized from distribute loops).
    assign product = p1 + p2 + p3 + p4 + p5 + p6
                   + p15 + p16 + p17 + p18
                   + p19 + p20 + p21 + p22 + p23 + p24 + p25;

endmodule
