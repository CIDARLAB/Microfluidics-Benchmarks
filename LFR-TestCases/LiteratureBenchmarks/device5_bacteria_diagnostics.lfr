// device5_bacteria_diagnostics — mix + detection to one outlet.
// Purpose: combine sample/reagent inlets p1–p3 into a single product on p4.
// Linearized (no distribute) so chambers stay on one connected island.
// Topology: star merge p1+p2+p3 → p4 (no intermediate storage or MAP).
// Collaborators: cp1/cp2 control ports are declared for pumping/valves but unused here.
// Simplest literature benchmark — single continuous assign path.

module device5_bacteria_diagnostics(
    finput p1, p2, p3,     // sample + two reagent / buffer inlets
    foutput p4,            // combined detection / product outlet
    control cp1, cp2       // pump/valve controls (declared; unused in linearized body)
);

    // Merge all three inlets onto the single product outlet.
    assign p4 = p1 + p2 + p3;

endmodule
