// sorting — 1-to-3 connected flow split for cell sorting.
// Purpose: Divide inlet `a` into three connected outlet streams.
// Topology: FLOW: `a` / 3 → `part_*` → `a_out`,`b_out`,`c_out`.
// Collaborator takeaway: Use LHS temps for /N splits; do not put outlets on the RHS before assignment.
module sorting (
    finput a,  // FLOW inlet(s)
    foutput a_out, b_out, c_out  // FLOW outlet(s)
);
    flow part_a, part_b, part_c;  // intermediate FLOW net(s)
    assign {part_a, part_b, part_c} = a / 3;  // equal FLOW split into parts
    assign a_out = part_a;  // continuous FLOW assign
    assign b_out = part_b;  // continuous FLOW assign
    assign c_out = part_c;  // continuous FLOW assign
endmodule
