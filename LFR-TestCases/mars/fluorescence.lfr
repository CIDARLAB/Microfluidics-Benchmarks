module fluorescence (
    finput b, c, d,
    control c1
);

//  input toehold and trigger RNA
    flow mixture;
    storage chamber;

    assign mixture = b%200 + c%200;

//  send the mixture to chamber
    assign chamber = mixture;

//  send master mix to chamber
    distribute@(c1) begin 
        if (c1 == 1)
            chamber <= d;
    end

endmodule