// ligation — five-reagent ligation with dual control gates.
// Purpose: Meter five reagents, incubate the mix, release to `g_out`.
// Topology: FLOW: metered mix → (~ INCUBATOR) → `g_out`. CONTROL: `c1`,`c2` gate emission edges.
// Collaborator takeaway: Two controls emit as Cport–valve subnetworks on the product path.
module ligation (
    finput b, c, d, e, f,  // FLOW inlet(s)
    foutput g_out,  // FLOW outlet(s)
    control c1, c2  // CONTROL select/gate — does not carry fluid
);
    flow mixture;  // intermediate FLOW net(s)
    assign mixture = b%500 + c%500 + d%500 + e%500 + f%500;  // meter / dropletize (FLOW)
    flow incubated;  // intermediate FLOW net(s)
    #MAP "INCUBATOR" "~"  // tech-map: operator/keyword → component
    assign incubated = ~mixture;  // continuous incubate path (keeps flow connected)

    // CONTROL emission: declared control bits gate a flow edge (Cport–valve subnetworks)
    flow __ctrl_emit_src;
    assign __ctrl_emit_src = incubated;
    distribute@(c1) begin
        if (c1 == 1)
            g_out <= __ctrl_emit_src;
    end
    distribute@(c2) begin
        if (c2 == 1)
            g_out <= __ctrl_emit_src;
    end

endmodule
