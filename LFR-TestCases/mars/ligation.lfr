// ligation — five-reagent ligation with dual control gates.
// Purpose: Meter five reagents; under `c1` incubate the mix; under `c2` release to `g_out`.
// Topology: FLOW: metered mix → (CONTROL `c1`, ~ INCUBATOR) `incubated` → (CONTROL `c2`) `g_out`.
// Collaborator takeaway: Two controls: one loads incubator, one releases product.
module ligation (
    finput b, c, d, e, f,  // FLOW inlet(s)
    foutput g_out,  // FLOW outlet(s)
    control c1, c2  // CONTROL select/gate — does not carry fluid
);
    flow mixture;  // intermediate FLOW net(s)
    assign mixture = b%500 + c%500 + d%500 + e%500 + f%500;  // meter / dropletize (FLOW)
    flow incubated;  // intermediate FLOW net(s)
    #MAP "INCUBATOR" "~"  // tech-map: operator/keyword → component
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c1) begin
        if (c1 == 1)  // CONTROL predicate for this FLOW arm
            incubated <= ~mixture;  // gated FLOW assign in this control arm
    end
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c2) begin
        if (c2 == 1)  // CONTROL predicate for this FLOW arm
            g_out <= incubated;  // gated FLOW assign in this control arm
    end
endmodule
