module ligation (
    finput b, c, d, e, f,
    foutput g_out,
    control c1, c2
);

//  mix T4 DNA lygase buffer, vector DNA, insert DNA, Nuclease-free water, and T4 DNA lygase
    flow mixture;
    assign mixture = b%500 + c%500 + d%500 + e%500 + f%500;

//  incubate
    flow incubated;
    
    #MAP "INCUBATOR" "~"

    distribute@(c1) begin 
        if (c1 == 1)
            incubated <= ~mixture;
    end

    distribute@(c2) begin 
        if (c2 == 1)
            g_out <= incubated;
    end


endmodule