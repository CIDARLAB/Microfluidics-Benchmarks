// antibiotic_resistance — multi-chamber antibiotic screening.
// Purpose: Broadcast suspended cells into ten antibiotic chambers; route excess cells out.
// Topology: FLOW: `a` → `chamber[0:9]`; also `a` → `a_out`.
// Collaborator takeaway: Broadcast into storage array plus excess bypass.
module antibiotic_resistance (
    finput a,  // FLOW inlet(s)
    foutput a_out  // FLOW outlet(s)
);
    storage [0:9] chamber;  // STORAGE / chamber node(s)
    assign chamber[0:9] = a;  // continuous FLOW assign
    assign a_out = a;  // continuous FLOW assign
endmodule
