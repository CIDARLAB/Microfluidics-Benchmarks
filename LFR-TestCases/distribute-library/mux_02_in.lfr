// mux_02_in — 1-to-2 demultiplexer (library primitive).
// Purpose: Under 1-bit control `c_select`, steer a single flow inlet onto one of two outlet lanes (despite the `_in` name, topology is 1→2).
// Topology: FLOW: `input` → selected `outputs[i]`. CONTROL: `c_select` chooses the active lane inside `distribute`.
// Collaborator takeaway: Named `_in` historically but behaves as a demux: one flow in, many flow outs, control steers.
module mux_02_in(
    finput input,  // FLOW inlet(s)
    foutput [0:1] outputs,  // FLOW outlet(s)
    control c_select  // CONTROL select/gate — does not carry fluid
);
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c_select)
    begin
        if(c_select == 1)  // CONTROL predicate for this FLOW arm
            outputs[0] <= input;  // FLOW edge enabled in this control arm
        else  // alternate CONTROL arm
            outputs[1] <= input;  // FLOW edge enabled in this control arm
    end


endmodule
