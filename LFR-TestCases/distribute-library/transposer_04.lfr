// transposer_04 — 4-lane bus interconnect (linearized).
// Purpose: Scalar IO with every inlet in every outlet expression so the device compiles as one connected component.
// Topology: FLOW: each `o*` = `i0+i1+i2+i3`. CONTROL: `c_select[0:2]` declared for interface but unused in assigns.
// Collaborator takeaway: Linearized substitute for a true controlled permute; keep control ports for call-site compatibility.
module transposer_04(
    finput i0, i1, i2, i3,  // FLOW inlet(s)
    foutput o0, o1, o2, o3,  // FLOW outlet(s)
    control [0:2] c_select  // CONTROL select/gate — does not carry fluid
);
    assign o0 = i0 + i1 + i2 + i3;  // FLOW merge / mix
    assign o1 = i0 + i1 + i2 + i3;  // FLOW merge / mix
    assign o2 = i0 + i1 + i2 + i3;  // FLOW merge / mix
    assign o3 = i0 + i1 + i2 + i3;  // FLOW merge / mix
endmodule
