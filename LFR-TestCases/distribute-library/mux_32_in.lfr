// mux_32_in — 1-to-32 demultiplexer (library primitive).
// Purpose: Under 5-bit control `c_select`, steer a single flow inlet onto one of thirty-two outlet lanes (despite the `_in` name, topology is 1→32).
// Topology: FLOW: `input` → selected `outputs[i]`. CONTROL: `c_select` chooses the active lane inside `distribute`.
// Collaborator takeaway: Named `_in` historically but behaves as a demux: one flow in, many flow outs, control steers.
module mux_32_in(
    finput input,  // FLOW inlet(s)
    foutput [0:31] outputs,  // FLOW outlet(s)
    control [0:4] c_select  // CONTROL select/gate — does not carry fluid
);
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c_select)
    begin
        case(c_select)  // CONTROL value selects which FLOW arm runs
            5'b00000 : outputs[0] <= input;  // FLOW edge enabled in this control arm
            5'b00001 : outputs[1] <= input;  // FLOW edge enabled in this control arm
            5'b00010 : outputs[2] <= input;  // FLOW edge enabled in this control arm
            5'b00011 : outputs[3] <= input;  // FLOW edge enabled in this control arm
            5'b00100 : outputs[4] <= input;  // FLOW edge enabled in this control arm
            5'b00101 : outputs[5] <= input;  // FLOW edge enabled in this control arm
            5'b00110 : outputs[6] <= input;  // FLOW edge enabled in this control arm
            5'b00111 : outputs[7] <= input;  // FLOW edge enabled in this control arm
            5'b01000 : outputs[8] <= input;  // FLOW edge enabled in this control arm
            5'b01001 : outputs[9] <= input;  // FLOW edge enabled in this control arm
            5'b01010 : outputs[10] <= input;  // FLOW edge enabled in this control arm
            5'b01011 : outputs[11] <= input;  // FLOW edge enabled in this control arm
            5'b01100 : outputs[12] <= input;  // FLOW edge enabled in this control arm
            5'b01101 : outputs[13] <= input;  // FLOW edge enabled in this control arm
            5'b01110 : outputs[14] <= input;  // FLOW edge enabled in this control arm
            5'b01111 : outputs[15] <= input;  // FLOW edge enabled in this control arm
            5'b10000 : outputs[16] <= input;  // FLOW edge enabled in this control arm
            5'b10001 : outputs[17] <= input;  // FLOW edge enabled in this control arm
            5'b10010 : outputs[18] <= input;  // FLOW edge enabled in this control arm
            5'b10011 : outputs[19] <= input;  // FLOW edge enabled in this control arm
            5'b10100 : outputs[20] <= input;  // FLOW edge enabled in this control arm
            5'b10101 : outputs[21] <= input;  // FLOW edge enabled in this control arm
            5'b10110 : outputs[22] <= input;  // FLOW edge enabled in this control arm
            5'b10111 : outputs[23] <= input;  // FLOW edge enabled in this control arm
            5'b11000 : outputs[24] <= input;  // FLOW edge enabled in this control arm
            5'b11001 : outputs[25] <= input;  // FLOW edge enabled in this control arm
            5'b11010 : outputs[26] <= input;  // FLOW edge enabled in this control arm
            5'b11011 : outputs[27] <= input;  // FLOW edge enabled in this control arm
            5'b11100 : outputs[28] <= input;  // FLOW edge enabled in this control arm
            5'b11101 : outputs[29] <= input;  // FLOW edge enabled in this control arm
            5'b11110 : outputs[30] <= input;  // FLOW edge enabled in this control arm
            5'b11111 : outputs[31] <= input;  // FLOW edge enabled in this control arm
        endcase
    end
endmodule
