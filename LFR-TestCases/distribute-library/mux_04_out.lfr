// mux_04_out — 1-to-4 demultiplexer (library primitive).
// Purpose: Under 2-bit control `c_select`, steer a single flow inlet onto one of four outlet lanes.
// Topology: FLOW: `input` → selected `outputs[i]`. CONTROL: `c_select` chooses the active lane inside `distribute`/`case`.
// Collaborator takeaway: Control picks the lane; only flow ports carry fluid. Inactive outlets are not driven in that arm.
module mux_04_out(
    finput input,  // FLOW inlet(s)
    foutput [0:3] outputs,  // FLOW outlet(s)
    control [0:1] c_select  // CONTROL select/gate — does not carry fluid
);
    // DISTRIBUTE: control-gated flow routing (control selects arms; flow carries fluid)
    distribute@(c_select)
    begin
        case(c_select)  // CONTROL value selects which FLOW arm runs
            2'b00 : outputs[0] <= input;  // FLOW edge enabled in this control arm
            2'b01 : outputs[1] <= input;  // FLOW edge enabled in this control arm
            2'b10 : outputs[2] <= input;  // FLOW edge enabled in this control arm
            2'b11 : outputs[3] <= input;  // FLOW edge enabled in this control arm
        endcase
    end


endmodule
