// issue8 — Whitesides-style gradient (p,q,r) to out[0:8] (GitHub #8).
// Purpose: Same coefficient style as gradient.lfr; every outlet lane driven.
// Topology: FLOW: `p,q,r` weighted mixes → `out[0]..out[8]`.
// Collaborator takeaway: Avoid nested fluid−fluid `-` inside one bracket expression.
module issue8(
    finput p, q, r,  // FLOW inlet(s)
    foutput [0:8] out  // FLOW outlet(s)
);
    assign out[0] = p;  // continuous FLOW assign
    assign out[1] = (1.0/9.0)*(6.0*p + 3.0*q);  // FLOW merge / mix
    assign out[2] = (1.0/36.0)*(15.0*p + 18.0*q + r);  // FLOW merge / mix
    assign out[3] = (5.0/84.0)*(4.0*p + 9.0*q + 2.0*r);  // FLOW merge / mix
    assign out[4] = (1.0/42.0)*(5.0*p + 20.0*q + 9.0*r);  // FLOW merge / mix
    assign out[5] = (1.0/126.0)*(6.0*p + 45.0*q + 40.0*r);  // FLOW merge / mix
    assign out[6] = (1.0/84.0)*(p + 18.0*q + 37.0*r);  // FLOW merge / mix
    assign out[7] = (1.0/12.0)*(q + 6.0*r);  // FLOW merge / mix
    assign out[8] = (1.0/3.0)*r;  // continuous FLOW assign
endmodule
