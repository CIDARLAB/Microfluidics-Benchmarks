// issue9 — 16-lane bus reduce to one outlet (GitHub #9).
// Purpose: Every bus lane appears in the outlet expression (distribute left lanes floating).
// Topology: FLOW: sum of `i0..i15` → `out`. CONTROLs interface-only.
// Collaborator takeaway: Prefer explicit sum over distribute when reducing a wide bus.
module issue9(
    finput i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11, i12, i13, i14, i15,  // FLOW inlet(s)
    foutput out,  // FLOW outlet(s)
    control x9, x1, inlet  // CONTROL select/gate — does not carry fluid
);
    assign out = i0 + i1 + i2 + i3 + i4 + i5 + i6 + i7  // FLOW merge / mix
               + i8 + i9 + i10 + i11 + i12 + i13 + i14 + i15;
endmodule
