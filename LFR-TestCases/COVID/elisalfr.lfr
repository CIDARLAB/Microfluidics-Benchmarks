// elisalfr — ELISA-style sequential mixing with two readout ports.
// Purpose: combine buffer+syringe (diluent), then form an assay that also
//   includes sample. Both the diluent tap (out1) and the final assay (out2)
//   stay on one graph by sharing the same inlet PORTs in both mix expressions.
// Topology: buffer+syringe → out1; buffer+syringe+sample → out2.
// Collaborator takeaway: shared inlets keep two outlets in one connected island.
module elisalfr(
    finput buffer, syringe, sample,  // diluent reagents + sample
    foutput out1, out2               // diluent tap and final assay outlets
);

    flow diluent;  // buffer + syringe mix
    flow assay;    // diluent + sample mix

    // Merge: diluent path (exposed on out1)
    assign diluent = buffer + syringe;
    // Route diluent to first outlet
    assign out1 = diluent;

    // Merge: assay reuses same inlets plus sample (keeps one island)
    assign assay = buffer + syringe + sample;
    // Route assay to second outlet
    assign out2 = assay;

endmodule
