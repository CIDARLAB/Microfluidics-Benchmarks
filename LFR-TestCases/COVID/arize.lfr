// arize — ARIZE / SHERLOCK two-step assay chip.
// Purpose: step 1 mixes seven "a" reagents (also exposed on out1); step 2
//   mixes those same a-inlets with nine "b" reagents into out2. Sharing the
//   a-inlets across both expressions keeps a single connected netlist
//   (avoids `/` splitter islands and floating PORTs).
// Topology: a-inlets → mix_a → out1; (a-inlets + b-inlets) → mix_b → out2.
// Collaborator takeaway: shared ports connect multi-outlet assays without splitters.
module arize(
    finput in1a, in2a, in3a, in4a, in5a, in6a, in7a,          // step-1 "a" reagents
           in1b, in2b, in3b, in4b, in5b, in6b, in7b, in8b, in9b,  // step-2 "b" reagents
    foutput out1, out2                                        // step-1 tap and full mix outlets
);

    flow mix_a;  // seven-a reagent mix (step 1)
    flow mix_b;  // a+b full assay mix (step 2)

    // Merge: step-1 product (tap)
    assign mix_a = in1a + in2a + in3a + in4a + in5a + in6a + in7a;
    // Route step-1 mix to out1
    assign out1 = mix_a;

    // Merge: all a-reagents + all b-reagents (connected via shared a-ports)
    assign mix_b = in1a + in2a + in3a + in4a + in5a + in6a + in7a
                 + in1b + in2b + in3b + in4b + in5b + in6b + in7b + in8b + in9b;
    // Route full mix to out2
    assign out2 = mix_b;

endmodule
