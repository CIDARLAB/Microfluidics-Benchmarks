// part2_lfr — COVID assay fragment (part 2 / RT step).
// Purpose: merge four reagent inlets into one product outlet.
// Topology: (p1+p2) and (p3+p4) mix in parallel, then merge to `out`.
// Collaborator takeaway: balanced two-branch merge before a single outlet.
module part2_lfr(
    finput p1, p2, p3, p4,  // four RT-step reagent inlets
    foutput out             // combined product outlet
);

    flow leftside;   // left pair mix result
    flow rightside;  // right pair mix result
    flow final;      // merged product before outlet

    // Merge: left reagent pair
    assign leftside = p1 + p2;
    // Merge: right reagent pair
    assign rightside = p3 + p4;
    // Merge: join both branches
    assign final = leftside + rightside;
    // Route product to outlet
    assign out = final;

endmodule
