// electro4 — multi-lane gel electrophoresis assist device.
// Purpose: combine DNA, denaturant, probe, and gel feed, then expose the
//   product on gelout and exit. Both outlets reuse the same inlet PORTs so
//   the compiled netlist stays one connected component.
// Topology: (dna+denaturing+probe+gelin) → gelout and exit (shared inlets).
// Collaborator takeaway: duplicate mix expressions on shared PORTs avoid islands.
module electro4(
    finput dna_line, denaturing_line, probe_line, gelin,  // DNA, denaturant, probe, gel feed
    foutput exit, gelout                                  // exit and gel-load outlets
);

    // Merge: full gel mix driven to gelout
    assign gelout = dna_line + denaturing_line + probe_line + gelin;
    // Merge: same mix reused on exit (keeps one connected component)
    assign exit = dna_line + denaturing_line + probe_line + gelin;

endmodule
