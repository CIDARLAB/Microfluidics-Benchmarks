// covid_crispr — minimal two-inlet CRISPR COVID mix.
// Purpose: connect two inlets through intermediate flows, merge them into
//   a single product stream, and drive `out_port`.
// Topology: in_port1 → in_flow1 ┐
//           in_port2 → in_flow2 ┴→ product → out_port.
// Collaborator takeaway: placeholder CRISPR assay topology; trivial merge.
module covid_crispr(
    finput in_port1, in_port2,  // two CRISPR assay inlets
    foutput out_port            // merged product outlet
);

    flow in_flow1;  // passthrough from in_port1
    flow in_flow2;  // passthrough from in_port2
    flow product;   // merged intermediate before outlet

    // Route inlet 1 into intermediate flow
    assign in_flow1 = in_port1;
    // Route inlet 2 into intermediate flow
    assign in_flow2 = in_port2;

    // Merge: combine both intermediate flows
    assign product = in_flow1+in_flow2;
    
    // Route product to outlet
    assign out_port = product;

endmodule
