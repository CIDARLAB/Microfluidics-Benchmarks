// crispr — CRISPR/Cas12a reagent formulation (SHERLOCK-style prep).
// Purpose: mix water, NEBuffer, LbCas12a, and gRNA, incubate, then add
//   reporter and drive the complex to the outlet. Unary `~` maps to MIXER.
// Topology: reagents → mix → +reporter → mix → complex.
// Collaborator takeaway: unique intermediate names avoid double-assign on
//   the same LHS (which previously split the netlist).
module Crispr(
    finput water, nebuffer, lbcas12a, grna, reporter,  // CRISPR reagents + reporter
    foutput complex                                    // formulated complex outlet
);

    #MAP "MIXER" "~"  // map unary ~ to MIXER component

    flow reagents;       // core CRISPR reagent mix
    flow incubated;      // post-mix / incubation stage
    flow with_reporter;  // complex after reporter addition
    flow product;        // final mix before outlet

    // Merge: combine core CRISPR reagents
    assign reagents = water + nebuffer + lbcas12a + grna;

    // Mix/incubate (mapped MIXER)
    assign incubated = ~reagents;

    // Merge: add reporter to incubated reagents
    assign with_reporter = incubated + reporter;
    // Mix again before outlet
    assign product = ~with_reporter;
    // Route product to outlet
    assign complex = product;

endmodule
