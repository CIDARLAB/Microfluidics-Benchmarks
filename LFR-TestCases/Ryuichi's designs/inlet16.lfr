// inlet16
// Purpose: 16-inlet multiplexer / culture chip (Coolsey / Sip / Folch,
// Lab Chip 2009). Full bus wiring of all 16 inlets through mix stages
// with rinse and side_inlet into a chamber, then one outlet.
// Topology: inlet[0:15] → Multiplexer(~) → mux_merged + rinse+side → FlowCtrl(~) → out.
// Collaborators: rinse/side_inlet fold into chamber after mux; control[6:0] unused here.
// Multiplexer MAP then Flow Controller MAP keep all PORTs on one continuous path.

module inlet16(
    finput [0:15] inlet,          // sixteen multiplexed culture / reagent inlets
    finput rinse, side_inlet,     // rinse line + side feed into the chamber
    foutput out,                  // single culture / product outlet
    control [6:0] x               // valve control bus (declared; unused in body)
);

    flow [0:15] inlet_bus;                          // internal bus mirroring all 16 inlets
    assign inlet_bus[0:15] = inlet[0:15];           // wire full inlet bus onto inlet_bus

    flow [0:15] after_inlets;                       // post-multiplexer bus
    #MAP "Multiplexer" "~"                          // map unary ~ to Multiplexer process
    assign after_inlets[0:15] = ~inlet_bus[0:15];   // multiplex / process every inlet channel

    storage mux_merged;                             // collapse muxed bus into one storage
    assign mux_merged = after_inlets[0:15];         // merge after_inlets into mux_merged

    // Fold rinse and side_inlet into the same storage junction.
    storage chamber;                                           // shared culture chamber
    assign chamber = mux_merged + rinse + side_inlet;          // combine mux + rinse + side feed

    flow flow_out;                                  // post flow-controller stream
    #MAP "Flow Controller" "~"                      // map unary ~ to Flow Controller
    assign flow_out = ~chamber;                     // regulate chamber outflow

    assign out = flow_out;                          // drive the single outlet


    // CONTROL emission: declared control bits gate a flow edge (Cport–valve subnetworks)
    flow __ctrl_emit_src;
    assign __ctrl_emit_src = inlet[0] + inlet[1] + inlet[2] + inlet[3] + inlet[4] + inlet[5] + inlet[6] + inlet[7] + inlet[8] + inlet[9] + inlet[10] + inlet[11] + inlet[12] + inlet[13] + inlet[14] + inlet[15] + rinse + side_inlet;
    distribute@(x[0]) begin
        if (x[0] == 1)
            out <= __ctrl_emit_src;
    end
    distribute@(x[1]) begin
        if (x[1] == 1)
            out <= __ctrl_emit_src;
    end
    distribute@(x[2]) begin
        if (x[2] == 1)
            out <= __ctrl_emit_src;
    end
    distribute@(x[3]) begin
        if (x[3] == 1)
            out <= __ctrl_emit_src;
    end
    distribute@(x[4]) begin
        if (x[4] == 1)
            out <= __ctrl_emit_src;
    end
    distribute@(x[5]) begin
        if (x[5] == 1)
            out <= __ctrl_emit_src;
    end
    distribute@(x[6]) begin
        if (x[6] == 1)
            out <= __ctrl_emit_src;
    end

endmodule
