// olfactory
// Purpose: C. elegans olfactory / neuronal-imaging chip
// (Chronis / Zimmer / Bargmann, Nat. Methods).
// Stimulus, buffer, and dyes merge into a shared chamber that feeds
// both the worm channel and left outlet.
// Topology: 4-inlet merge → feed flow → storage junction → fan-out to 2 foutputs.
// Collaborators: `control c` is declared for valveing but unused in this linearized netlist.
// Junction storage keeps both outlets on one continuous island with the feed.

module olfactory(
    finput stimulus, buffer, left_dye, right_dye,  // odor stimulus, carrier buffer, imaging dyes
    foutput worm, left_outlet,                     // worm imaging channel + left collection outlet
    control c                                      // control line (declared; unused in linearized body)
);

    flow feed;                                                     // combined inlet feed stream
    assign feed = stimulus + buffer + left_dye + right_dye;        // merge all four inlets

    storage junction;                                              // shared chamber / junction
    assign junction = feed;                                        // load junction from merged feed

    assign worm = junction;                                        // route junction into worm channel
    assign left_outlet = junction;                                 // route same junction to left outlet

endmodule
