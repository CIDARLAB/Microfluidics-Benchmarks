// rootchip
// Purpose: RootChip for plant-science perfusion
// (Grossmann / Guo / Ehrhardt / Frommer / Sit / Quake / Meier).
// Three inlets bus-merge into storage, then fan to eight plant outlets.
// Topology: flow_in[0:2] → in_bus → merge_store → plant_store[0:7] → plant[0:7].
// Collaborators: control[0:16] models valve bank but is unused in this linearized body.
// Storage fan-out keeps all eight plant ports on one connected island.

module rootchip(
    finput [0:2] flow_in,     // three perfusion / media inlets
    foutput [0:7] plant,      // eight plant-root culture outlets
    control [0:16] c          // valve control bank (declared; unused in linearized body)
);

    flow [0:2] in_bus;                        // internal bus mirroring the three inlets
    assign in_bus[0:2] = flow_in[0:2];        // wire full inlet bus onto in_bus

    storage merge_store;                      // shared merge / holding storage
    assign merge_store = in_bus[0:2];         // collapse bus into one storage node

    storage [0:7] plant_store;                // per-plant storage bank (8 chambers)
    assign plant_store = merge_store;         // fan merge_store into all plant chambers

    assign plant[0:7] = plant_store[0:7];     // expose plant chambers on the eight outlets

endmodule
