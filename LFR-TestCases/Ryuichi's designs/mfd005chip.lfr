// mfd005chip
// Purpose: mother machine / DAW chemostat chip (Ferry / Razinkov / Hasty,
// Methods Enzymol. 2011). Dual aqueous inlets form a DAW junction that
// feeds a cell trap (with port + outlet access) and drains to waste.
// Topology: inlets+port+outlet → daw → DAW(~) → TRAP(~) → trap → shunt(~) → waste.
// Collaborators: `port` and `outlet` are finputs (access ports), not foutputs.
// Sequential MAP stages model DAW junction, cell trap, and shunt-to-waste.

module mfd005chip(
    finput inlet1, inlet2, port, outlet,  // dual aqueous inlets + trap port/outlet access
    foutput waste                         // cell / shunt waste drain
);

    flow daw;                                              // pre-junction combined stream
    assign daw = inlet1 + inlet2 + port + outlet;          // merge all four flow inputs

    flow daw_out;                                          // post-DAW junction stream
    #MAP "DAW junction" "~"                                // map unary ~ to DAW junction
    assign daw_out = ~daw;                                 // process through DAW junction

    flow trap_proc;                                        // post-trap process stream
    #MAP "TRAP" "~"                                        // map unary ~ to TRAP process
    assign trap_proc = ~daw_out;                           // process through cell trap

    storage trap;                                          // cell trap holding storage
    assign trap = trap_proc;                               // load trap from trap_proc

    flow shunt_waste;                                      // post-shunt waste stream
    #MAP "Cell and shunt waste" "~"                        // map unary ~ to shunt-waste process
    assign shunt_waste = ~trap;                            // drain trap through shunt

    assign waste = shunt_waste;                            // drive waste outlet

endmodule
