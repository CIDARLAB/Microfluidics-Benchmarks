// microreactor
// Purpose: steady-state cell-free gene-expression microreactor / chemostat
// (Laohakunakorn / Lavickova / Swank / Laurent / Maerkl).
// Inlet feeds DNA, protein, and energy storage chambers; their mixture
// drives the outlet on one continuous assign path.
// Topology: in → {dna, proteins, energy} storages; mix_all = in+storages → out.
// Collaborators: control[0:8] and c_start are declared for valving but unused here.
// Re-including `in` in mix_all keeps the inlet PORT on the continuous graph.

module microreactor (
    finput in,                 // shared reagent / media inlet
    foutput out,               // mixed microreactor product outlet
    control [0:8] c, c_start   // valve bank + start control (declared; unused in body)
);

    storage dna, proteins, energy;   // DNA template, protein, and energy chambers

    assign dna = in;                 // load DNA chamber from inlet
    assign proteins = in;            // load protein chamber from inlet
    assign energy = in;              // load energy chamber from inlet

    flow mix_all;                                      // combined reactor stream
    assign mix_all = in + dna + proteins + energy;     // merge inlet + all three chambers

    assign out = mix_all;                              // drive outlet from the mix

endmodule
