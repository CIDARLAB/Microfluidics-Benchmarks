// chemostat_chip
// Purpose: cell-free gene-expression chemostat array
// (Laohakunakorn / Lavickova / Swank / Laurent / Maerkl).
// Nine inlets bus-wire through a mixer into a storage feed that fans
// into eight microreactor chambers and collects to one outlet.
// Topology: in[0:8] → in_bus → MIXER(~) → feed → reactor[0:7] → out.
// Collaborators: c1–c4 control banks model valves; unused in linearized body.
// Companion to nine_to_one_mux / microreactor designs in the same paper family.

module chemostat_chip (
    finput [0:8] in,                              // nine reagent / media inlets
    foutput out,                                  // collected chemostat product outlet
    control [0:5] c1, [0:7] c2, [0:8] c3, c4     // valve control banks (declared; unused)
);

    flow [0:8] in_bus;                        // internal bus mirroring all nine inlets
    assign in_bus[0:8] = in[0:8];             // wire full inlet bus onto in_bus

    flow [0:8] mixed;                         // post-mixer reagent bus
    #MAP "MIXER" "~"                          // map unary ~ to a MIXER process
    assign mixed[0:8] = ~in_bus[0:8];         // mix every bus channel

    storage feed;                             // collapse mixed bus into one feed
    assign feed = mixed[0:8];                 // merge mixed channels into feed

    storage [0:7] reactor;                    // eight microreactor chambers
    assign reactor = feed;                    // fan feed into all reactors

    assign out = reactor;                     // collect reactors to the single outlet

endmodule
