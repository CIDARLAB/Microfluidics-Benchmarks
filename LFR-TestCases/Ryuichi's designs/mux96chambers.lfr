// mux96chambers
// Purpose: 96-chamber microfluidic culture array with 16-inlet mux
// (Gomez-Sjoberg / Leyrat / Pirone / Chen / Quake, Anal. Chem. 2007).
// 16 inlets bus-wire through mix/pump into a storage feed that fans
// into all 96 chambers, then collects to waste.
// Topology: in[0:15] → in_bus → Mixer(~) → Pump(~) → feed → chamber[0:95] → waste.
// Collaborators: MAP spellings ("Mixer"/"Pump") are intentional process labels — keep them.
// Full 96-chamber fan-out models the culture array; waste is the shared drain.

module mux96chambers(
    finput [0:15] in,   // sixteen multiplexed reagent / media inlets
    foutput waste       // shared waste / collection outlet from all chambers
);

    flow [0:15] in_bus;                         // internal bus mirroring all 16 inlets
    assign in_bus[0:15] = in[0:15];             // wire full inlet bus onto in_bus

    flow [0:15] mixed;                          // post-mixer bus
    #MAP "Mixer" "~"                            // map unary ~ to Mixer process
    assign mixed[0:15] = ~in_bus[0:15];         // mix every bus channel

    flow [0:15] pumped;                         // post-pump bus
    #MAP "Pump" "~"                             // map unary ~ to Pump process
    assign pumped[0:15] = ~mixed[0:15];         // pump every mixed channel

    storage feed;                               // collapse pumped bus into one feed
    assign feed = pumped[0:15];                 // merge pumped channels into feed

    storage [0:95] chamber;                     // 96 culture chambers
    assign chamber = feed;                      // fan feed into all 96 chambers
    assign waste = chamber;                     // collect chambers to waste

endmodule
