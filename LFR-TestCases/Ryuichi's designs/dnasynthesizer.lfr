// dnasynthesizer
// Purpose: multi-reagent DNA synthesizer / reactor array.
// Eleven reagent inlets bus-wire through a mixer into a storage feed
// that fans into 16 reactors and 16 outlets.
// Topology: in[0:10] → in_bus → MIXER(~) → feed → reactor[0:15] → out[0:15].
// Collaborators: control[0:15] models per-reactor valves but is unused in linearized body.
// Bus-wide mix then storage collapse keeps all reagent PORTs on one island.

module dnasynthesizer(
    finput[0:10] in,          // eleven synthesis reagent inlets
    foutput [0:15] out,       // sixteen reactor product outlets
    control [0:15] c          // per-reactor valve controls (declared; unused in body)
);

    flow [0:10] in_bus;                       // internal bus mirroring all reagent inlets
    assign in_bus[0:10] = in[0:10];           // wire full inlet bus onto in_bus

    flow [0:10] mixed;                        // post-mixer reagent bus
    #MAP "MIXER" "~"                          // map unary ~ to a MIXER process
    assign mixed[0:10] = ~in_bus[0:10];       // mix every bus channel

    storage feed;                             // collapse mixed bus into one feed
    assign feed = mixed[0:10];                // merge mixed channels into feed

    storage [0:15] reactor;                   // sixteen synthesis reactor chambers
    assign reactor = feed;                    // fan feed into all reactors

    assign out[0:15] = reactor[0:15];         // expose each reactor on its outlet

endmodule
