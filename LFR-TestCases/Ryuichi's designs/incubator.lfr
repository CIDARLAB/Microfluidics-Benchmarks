// incubator
// Purpose: multi-purpose lab-on-a-chip incubator (Amin / Thakur / et al.).
// Five reagent inlets merge through pump / mixer / incubation stages into
// a shared storage junction that fans to three outlets.
// Topology: a+b+c+d+e → Pump1 → MIXER → Mixer_L→R → Incubator_L→R → Pump2 → junction → {x,y,z}.
// Collaborators: sequential MAP stages model the published process chain; valve[16:0] unused.
// Three outlets share junction storage so FLOW remains one connected island.

module incubator(
    finput a, b, c, d, e,     // five reagent / sample reservoir inlets
    foutput x, y, z,          // three product / collection outlets
    control [16:0] valve      // valve control bus (declared; unused in linearized body)
);

    flow reservoirs_out;                              // merged reservoir feed
    assign reservoirs_out = a + b + c + d + e;        // sum-merge all five inlets

    flow pump1_out;                                   // post-Pump1 stream
    #MAP "Pump1" "~"                                  // map unary ~ to Pump1
    assign pump1_out = ~reservoirs_out;               // pump the merged reservoirs

    flow mixer_left;                                  // left mixer stage output
    #MAP "MIXER" "~"                                  // map unary ~ to MIXER
    assign mixer_left = ~pump1_out;                   // mix after Pump1

    flow mixer_right;                                 // right mixer stage output
    #MAP "Mixer_left_to_right" "~"                    // map unary ~ to left→right mixer transfer
    assign mixer_right = ~mixer_left;                 // transfer / remix left → right

    flow incubator_right;                             // post-incubation stream
    #MAP "Incubator_left_to_right" "~"                // map unary ~ to incubator L→R stage
    assign incubator_right = ~mixer_right;            // incubate after mixer_right

    flow pump2_out;                                   // post-Pump2 stream
    #MAP "Pump2" "~"                                  // map unary ~ to Pump2
    assign pump2_out = ~incubator_right;              // pump after incubation

    storage junction;                                 // shared outlet junction storage
    assign junction = pump2_out;                      // load junction from Pump2

    assign x = junction;                              // route junction to outlet x
    assign y = junction;                              // route junction to outlet y
    assign z = junction;                              // route junction to outlet z

endmodule
