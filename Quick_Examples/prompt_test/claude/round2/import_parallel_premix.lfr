`import "library/two_in_mixer.lfr"
`import "library/three_in_mixer.lfr"

module import_parallel_premix(
    finput lane_a_r1, lane_a_r2, lane_b_r1, lane_b_r2, carrier,
    foutput outlet
);

flow premix_a, premix_b, combined;

two_in_mixer u0(.in_a(lane_a_r1), .in_b(lane_a_r2), .out_1(premix_a));
two_in_mixer u1(.in_a(lane_b_r1), .in_b(lane_b_r2), .out_1(premix_b));
three_in_mixer u2(.in_a(premix_a), .in_b(premix_b), .in_c(carrier), .out_1(combined));

assign outlet = combined;

endmodule