`import "library/three_in_mixer.lfr"
`import "library/droplet_generator.lfr"
`import "library/incubator.lfr"

module import_droplet_reaction(
    finput analyte, primer, buffer, oil_phase,
    foutput outlet
);

flow aqueous, droplets, incubated;

three_in_mixer u_three_in_mixer(
    .in_a(analyte),
    .in_b(primer),
    .in_c(buffer),
    .out_1(aqueous)
);

droplet_generator u_droplet_generator(
    .oil(oil_phase),
    .aqueous(aqueous),
    .droplets(droplets)
);

incubator u_incubator(
    .in_1(droplets),
    .out_1(incubated)
);

assign outlet = incubated;

endmodule