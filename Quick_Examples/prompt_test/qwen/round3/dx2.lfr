module dx2(
    finput in1, in2,
    foutput out1, out2
);
    flow droplets_in1, droplets_in2;
    flow merged;
    flow incubated;

    // Meter in1 into droplets with nominal volume 100
    assign droplets_in1 = in1 % 100;

    // Meter in2 into droplets with nominal volume 200
    assign droplets_in2 = in2 % 200;

    // Merge the two droplet streams
    assign merged = droplets_in1 + droplets_in2;

    // Tech-mapped mixer for incubation using unary ~ operator
    #MAP "MIXER" "~"
    assign incubated = ~merged;

    // Split: out2 is discard/side-branch, out1 is kept stream (incubated minus out2)
    assign out2 = incubated / 2;
    assign out1 = incubated - out2;
endmodule