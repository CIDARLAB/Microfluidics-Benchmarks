module flow_and_control_demo(
    finput inlet1, inlet2, inlet3,
    cinput c,
    foutput outlet
);

flow mixer_stream;

// Mix inlet1 and inlet2 first.
assign mixer_stream = inlet1 + inlet2;

// Distribute based on control signal c:
// c == 1 → mixer_stream
// otherwise → inlet3
distribute c {
    1: outlet = mixer_stream;
    default: outlet = inlet3;
}

endmodule