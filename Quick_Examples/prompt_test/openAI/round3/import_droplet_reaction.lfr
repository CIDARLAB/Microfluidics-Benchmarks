`import "library/three_in_mixer.lfr"
`import "library/droplet_generator.lfr"
`import "library/incubator.lfr"

module import_droplet_reaction(
    finput analyte, primer, buffer, oil_phase,
    foutput outlet
);

flow aqueous, droplets, incubated;

// Instantiate the reusable three-input mixer.
three_in_mixer mixer(
    .in_a(analyte),
    .in_b(primer),
    .in_c(buffer),
    .out_1(aqueous)
);

// Instantiate the reusable droplet generator.
droplet_generator dg(
    .oil(oil_phase),
    .aqueous(aqueous),
    .droplets(droplets)
);

// Instantiate the reusable incubator.
incubator inc(
    .in_1(droplets),
    .out_1(incubated)
);

assign outlet = incubated;

endmodule