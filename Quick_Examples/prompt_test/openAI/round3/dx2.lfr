module dx2(
    finput in1, in2,
    foutput out1, out2
);
flow droplets1, droplets2, merged, incubated;

assign droplets1 = in1 % 100;
assign droplets2 = in2 % 200;
assign merged = droplets1 + droplets2;

// Map the unary ~ operation to a physical mixer for incubation.
#MAP "MIXER" "~"
assign incubated = ~merged;

// ASSUMPTION: out2 is a side branch equal to half of the incubated stream.
assign out2 = incubated / 2;
assign out1 = incubated - out2;
endmodule