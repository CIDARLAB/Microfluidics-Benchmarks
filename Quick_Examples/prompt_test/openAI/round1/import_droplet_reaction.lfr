import three_in_mixer from "library/three_in_mixer.lfr";
import droplet_generator from "library/droplet_generator.lfr";
import incubator from "library/incubator.lfr";

module import_droplet_reaction(
    finput analyte, primer, buffer, oil_phase,
    foutput outlet
);

flow aqueous;
flow droplets;
flow incubated;

three_in_mixer mixer(
    .in_a(analyte),
    .in_b(primer),
    .in_c(buffer),
    .out_1(aqueous)
);

droplet_generator droplet_gen(
    .oil(oil_phase),
    .aqueous(aqueous),
    .droplets(droplets)
);

incubator incubator_1(
    .in_1(droplets),
    .out_1(incubated)
);

assign outlet = incubated;

endmodule