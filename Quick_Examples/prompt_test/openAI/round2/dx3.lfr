module dx3(
    finput in1, in2, in3,
    foutput out1, out2
);
flow droplets, daughter1, daughter2, mixed1, mixed2;

assign droplets = in1 % 100;
assign {daughter1, daughter2} = droplets / 2;

assign mixed1 = daughter1 + in2;
assign mixed2 = daughter2 + in3;

assign out1 = mixed1;
assign out2 = mixed2;
endmodule