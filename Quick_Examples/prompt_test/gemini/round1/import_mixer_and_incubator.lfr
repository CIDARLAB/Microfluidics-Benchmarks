`import "library/two_in_mixer.lfr"
`import "library/incubator.lfr"

module import_mixer_and_incubator(
    finput reagent_a, reagent_b,
    foutput outlet
);
flow mixed_flow;

two_in_mixer u_mixer(
    .in_a(reagent_a),
    .in_b(reagent_b),
    .out_1(mixed_flow)
);

incubator u_inc(
    .in_1(mixed_flow),
    .out_1(outlet)
);
endmodule