module dx2(
    finput in1, in2,
    foutput out1, out2
);
flow metered1, metered2, merged, incubated, discard;

assign metered1 = in1 % 100;
assign metered2 = in2 % 200;
assign merged = metered1 + metered2;

#MAP "MIXER" "~"
assign incubated = ~merged;

assign discard = incubated / 2;
assign out1 = incubated - discard;
assign out2 = discard;

endmodule