// test_DIY_fork — fork-shaped DIYCOMPONENT: two inlets, one outlet.
`import "library/DIYcomponent.lfr"

module test_DIY_fork(
    finput in_up, in_left,
    foutput out_down
);
    DIYcomponent #(length=10000, width=8000, height=2000) fork(
        .up(in_up),
        .right(None),
        .down(out_down),
        .left(in_left)
    );
endmodule
