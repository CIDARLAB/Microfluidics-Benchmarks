// Reusable building block: nozzle-type droplet generator.
// Combines a continuous oil phase with a dispersed aqueous phase to generate
// a droplet stream. The library primitive NOZZLE DROPLET GENERATOR is a
// single-inlet METER (%); oil is merged afterward with +. A #CONSTRAIN
// directive hints at the target droplet rate for downstream sizing.
module droplet_generator(
    finput oil, aqueous,
    foutput droplets
);
    flow metered;
    #MAP "NOZZLE DROPLET GENERATOR" "%"
    #CONSTRAIN "%" droplet_rate = 30 hz
    assign metered = aqueous % 100;
    assign droplets = metered + oil;
endmodule
