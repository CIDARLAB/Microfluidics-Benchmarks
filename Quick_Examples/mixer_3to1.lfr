//  Example: 3-to-1 two-stage mixer (flow only, no control).
//  Stage 1: merge in1 with in2 into an intermediate stream.
//  Stage 2: merge that intermediate with in3, and send the result to out.
module mixer_3to1(
    finput in1, in2, in3,
    foutput out
);
    flow mixed_12;

    assign mixed_12 = in1 + in2;
    assign out = mixed_12 + in3;
endmodule
