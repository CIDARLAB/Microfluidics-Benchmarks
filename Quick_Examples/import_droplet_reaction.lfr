//  Example: 3-reagent droplet reaction pipeline, built from library
//  modules plus two control valves on the chamber.
//
//  Topology:
//       analyte ---\
//       primer  --- three_in_mixer premix -- aqueous (term 4, from below)
//       buffer  ---/                         |
//                    oil_left (3) ---- droplet_generator ---- oil_right (1)
//                                            |   (JSON rotation 90)
//                                       droplets (term 2, horn up)
//                                            |
//                                      [valve c_in]
//                                            |
//                                    chamber (in 1 / out 3)
//                                            |
//                                      [valve c_out]
//                                            |
//                                          outlet
//
//  After the nozzle, there is exactly one pipe into the chamber and
//  exactly one pipe out to the outlet port. c_in gates filling the
//  chamber; c_out gates release to the outlet.
//
//  Stages:
//    1. three_in_mixer    : folds three reagents into a single aqueous stream.
//    2. droplet_generator : 4-port nozzle; side oil squeezes aqueous into droplets.
//    3. chamber           : holds the droplet train (REACTION CHAMBER).
//    4. c_in / c_out      : valves on the single inlet and outlet pipes.

`import "library/three_in_mixer.lfr"
`import "library/droplet_generator.lfr"

module import_droplet_reaction(
    finput analyte, primer, buffer, oil_left, oil_right,
    foutput outlet,
    control c_in, c_out
);
    flow aqueous, droplets;
    #MAP "REACTION CHAMBER" "storage"
    storage chamber;

    three_in_mixer premix(
        .in_a(analyte),
        .in_b(primer),
        .in_c(buffer),
        .out_1(aqueous)
    );

    droplet_generator gen(
        .oil_left(oil_left),
        .oil_right(oil_right),
        .aqueous(aqueous),
        .droplets(droplets)
    );

    // Valve on the single nozzle → chamber pipe.
    // distribute must write a port or storage, or the valve is dropped.
    distribute@(c_in)
    begin
        if (c_in == 1)
            chamber <= droplets;
    end

    // Valve on the single chamber → outlet pipe.
    distribute@(c_out)
    begin
        if (c_out == 1)
            outlet <= chamber;
    end
endmodule
