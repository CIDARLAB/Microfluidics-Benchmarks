module import_mixer_and_incubator(
    finput reagent_a, reagent_b,
    foutput outlet
);
flow mixed;

`import "library/two_in_mixer.lfr"
`import "library/incubator.lfr"

two_in_mixer mixer_u0(
    .in_a(reagent_a),
    .in_b(reagent_b),
    .out_1(mixed)
);

incubator incubator_u0(
    .in_1(mixed),
    .out_1(outlet)
);

endmodule