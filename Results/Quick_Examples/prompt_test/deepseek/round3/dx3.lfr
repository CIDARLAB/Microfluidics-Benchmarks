module dx3(
    finput in1, in2, in3,
    foutput out1, out2
);
flow metered, daughter1, daughter2, mixed1, mixed2;
// Meter in1 into droplets with nominal volume 100
assign metered = in1 % 100;
// Split equally into two daughter streams
assign {daughter1, daughter2} = metered / 2;
// Mix daughter1 with in2 -> out1
assign mixed1 = daughter1 + in2;
assign out1 = mixed1;
// Mix daughter2 with in3 -> out2
assign mixed2 = daughter2 + in3;
assign out2 = mixed2;
endmodule