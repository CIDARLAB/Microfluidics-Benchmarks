module dx2(
    finput in1, in2,
    foutput out1, out2
);
flow metered1, metered2, merged, incubated, discard;
// Metering: in1 -> droplets of nominal volume 100; in2 -> droplets of nominal volume 200
assign metered1 = in1 % 100;
assign metered2 = in2 % 200;
// Merge the two droplet streams
assign merged = metered1 + metered2;
// Tech-mapped mixer (~) with MIXER mapping
#MAP "MIXER" "~"
assign incubated = ~merged;
// Split: out1 is kept stream, out2 is discard/side-branch
assign discard = incubated / 2;
assign out1 = incubated - discard;
assign out2 = discard;
endmodule