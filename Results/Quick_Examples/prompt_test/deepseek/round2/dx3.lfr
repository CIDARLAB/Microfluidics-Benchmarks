module dx3(
    finput in1, in2, in3,
    foutput out1, out2
);
flow metered, daughter1, daughter2, mix1, mix2;

// Meter in1 into droplets (nominal volume 100)
assign metered = in1 % 100;

// Split metered droplets equally into two daughter streams
assign {daughter1, daughter2} = metered / 2;

// Mix first daughter stream with in2 → out1
assign mix1 = daughter1 + in2;
assign out1 = mix1;

// Mix second daughter stream with in3 → out2
assign mix2 = daughter2 + in3;
assign out2 = mix2;

endmodule