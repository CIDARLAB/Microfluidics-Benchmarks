import "library/two_in_mixer.lfr"
import "library/incubator.lfr"

module import_mixer_and_incubator(
    finput reagent_a, reagent_b,
    foutput outlet
);
flow mixed, incubated;

// Mix reagent_a and reagent_b
two_in_mixer u_mix(
    .in_a(reagent_a),
    .in_b(reagent_b),
    .out_1(mixed)
);

// Incubate the mixed stream
incubator u_inc(
    .in_1(mixed),
    .out_1(incubated)
);

assign outlet = incubated;

endmodule