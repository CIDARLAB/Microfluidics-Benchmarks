module flow_and_control_demo(
    finput inlet1, inlet2, inlet3,
    control c,
    foutput outlet
);
flow mixed, selected;

// Mix inlet1 and inlet2 into an intermediate stream
assign mixed = inlet1 + inlet2;

// Control-gated selection: c=1 -> mixed, c=0 -> inlet3
distribute@(c) begin
    if (c == 1'b1) selected <= mixed;
    else selected <= inlet3;
end

assign outlet = selected;

endmodule