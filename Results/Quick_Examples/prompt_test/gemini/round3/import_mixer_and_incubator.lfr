`import "library/two_in_mixer.lfr";
`import "library/incubator.lfr";

module import_mixer_and_incubator(
    finput reagent_a,
    finput reagent_b,
    foutput outlet
);

    fnode mixed_flow;

    two_in_mixer mixer(
        in_a = reagent_a,
        in_b = reagent_b,
        out_1 = mixed_flow
    );

    incubator inc(
        in_1 = mixed_flow,
        out_1 = outlet
    );

endmodule