`import "library/three_in_mixer.lfr"
`import "library/droplet_generator.lfr"
`import "library/incubator.lfr"

module import_droplet_reaction(
    finput analyte, primer, buffer, oil_phase,
    foutput outlet
);

flow aqueous_stream;
flow droplets_stream;

three_in_mixer mixer_inst(
    .in_a(analyte),
    .in_b(primer),
    .in_c(buffer),
    .out_1(aqueous_stream)
);

droplet_generator dg_inst(
    .oil(oil_phase),
    .aqueous(aqueous_stream),
    .droplets(droplets_stream)
);

incubator inc_inst(
    .in_1(droplets_stream),
    .out_1(outlet)
);

endmodule