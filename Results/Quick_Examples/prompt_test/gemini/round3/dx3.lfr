module dx3 (
    input fluid in1,
    input fluid in2,
    input fluid in3,
    output fluid out1,
    output fluid out2
);

    // Internal fluid signals
    fluid droplets;
    fluid daughter1;
    fluid daughter2;

    // Generate droplets from in1 with nominal volume of 100
    DropletGenerator #(
        .droplet_volume(100)
    ) dg1 (
        .in(in1),
        .out(droplets)
    );

    // Split droplets equally into two daughter streams
    Splitter #(
        .split_ratio(0.5)
    ) sp1 (
        .in(droplets),
        .out1(daughter1),
        .out2(daughter2)
    );

    // Mix first daughter stream with in2 to out1
    Mixer mix1 (
        .in1(daughter1),
        .in2(in2),
        .out(out1)
    );

    // Mix second daughter stream with in3 to out2
    Mixer mix2 (
        .in1(daughter2),
        .in2(in3),
        .out(out2)
    );

endmodule