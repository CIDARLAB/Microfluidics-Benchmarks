`import "library/three_in_mixer.lfr"
`import "library/droplet_generator.lfr"
`import "library/incubator.lfr"

module import_droplet_reaction(
    finput analyte, primer, buffer, oil_phase,
    foutput outlet
);
flow mixed_aqueous, drops;

three_in_mixer mixer_inst(
    .in_a(analyte),
    .in_b(primer),
    .in_c(buffer),
    .out_1(mixed_aqueous)
);

droplet_generator droplet_inst(
    .oil(oil_phase),
    .aqueous(mixed_aqueous),
    .droplets(drops)
);

incubator incubator_inst(
    .in_1(drops),
    .out_1(outlet)
);
endmodule