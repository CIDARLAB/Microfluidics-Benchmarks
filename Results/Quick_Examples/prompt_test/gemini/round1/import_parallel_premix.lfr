import "library/two_in_mixer.lfr";
import "library/three_in_mixer.lfr";

module import_parallel_premix (
    finput lane_a_r1,
    finput lane_a_r2,
    finput lane_b_r1,
    finput lane_b_r2,
    finput carrier,
    foutput outlet
) {
    fchannel premix_a;
    fchannel premix_b;

    two_in_mixer mixer_a (
        in_a: lane_a_r1,
        in_b: lane_a_r2,
        out_1: premix_a
    );

    two_in_mixer mixer_b (
        in_a: lane_b_r1,
        in_b: lane_b_r2,
        out_1: premix_b
    );

    three_in_mixer final_mixer (
        in_a: premix_a,
        in_b: premix_b,
        in_c: carrier,
        out_1: outlet
    );
}