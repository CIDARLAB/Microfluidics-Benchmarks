module dx3(
    finput in1, in2, in3,
    foutput out1, out2
);
    flow droplets_in1;
    flow daughter_1, daughter_2;

    // Meter in1 into droplets with nominal volume 100
    assign droplets_in1 = in1 % 100;

    // Equal split into two daughter streams
    assign {daughter_1, daughter_2} = droplets_in1 / 2;

    // First daughter stream mixed with in2 and leaves through out1
    assign out1 = daughter_1 + in2;

    // Second daughter stream mixed with in3 and leaves through out2
    assign out2 = daughter_2 + in3;
endmodule