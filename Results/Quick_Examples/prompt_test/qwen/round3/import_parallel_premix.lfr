`import "library/two_in_mixer.lfr"
`import "library/three_in_mixer.lfr"

module import_parallel_premix(
    finput lane_a_r1, lane_a_r2, lane_b_r1, lane_b_r2, carrier,
    foutput outlet
);
    flow premix_a;
    flow premix_b;
    flow final_mix;

    two_in_mixer u_premix_a(
        .in_a(lane_a_r1),
        .in_b(lane_a_r2),
        .out_1(premix_a)
    );

    two_in_mixer u_premix_b(
        .in_a(lane_b_r1),
        .in_b(lane_b_r2),
        .out_1(premix_b)
    );

    three_in_mixer u_final_mix(
        .in_a(premix_a),
        .in_b(premix_b),
        .in_c(carrier),
        .out_1(final_mix)
    );

    assign outlet = final_mix;
endmodule