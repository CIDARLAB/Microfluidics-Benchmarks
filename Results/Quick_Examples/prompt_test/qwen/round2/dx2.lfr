module dx2(
    finput in1, in2,
    foutput out1, out2
);

flow droplets_in1, droplets_in2, merged_droplets, incubated, discard;

assign droplets_in1 = in1 % 100;
assign droplets_in2 = in2 % 200;
assign merged_droplets = droplets_in1 + droplets_in2;

#MAP "MIXER" "~"
assign incubated = ~(merged_droplets);

// ASSUMPTION: split is an equal side-branch discard.
assign discard = incubated / 2;
assign out2 = discard;
assign out1 = incubated - discard;

endmodule