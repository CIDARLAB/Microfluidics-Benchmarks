module dx2(
    finput in1, in2,
    foutput out1, out2
);

flow d1, d2, merged, mixed;

// Meter in1 into droplets with nominal volume 100
assign d1 = in1 % 100;

// Meter in2 into droplets with nominal volume 200
assign d2 = in2 % 200;

// Merge the two droplet streams
assign merged = d1 + d2;

#MAP "MIXER" "~"
assign mixed = ~merged; // incubation mixer

// ASSUMPTION: out2 is the discard/side-branch split from the incubated mixture;
// out1 is the remaining kept stream (out1 = mixed - out2)
assign out2 = mixed / 2;
assign out1 = mixed - out2;

endmodule