module dx3(
    finput in1, in2, in3,
    foutput out1, out2
);

flow d1, branch_a, branch_b, mix1, mix2;

// Meter in1 into droplets with nominal volume 100
assign d1 = in1 % 100;

// Split the metered droplets equally into two daughter streams
assign {branch_a, branch_b} = d1 / 2;

#MAP "MIXER" "~"
assign mix1 = ~(branch_a + in2); // first daughter stream mixed with in2

#MAP "MIXER" "~"
assign mix2 = ~(branch_b + in3); // second daughter stream mixed with in3

assign out1 = mix1;
assign out2 = mix2;

endmodule