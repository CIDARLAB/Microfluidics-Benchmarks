module dx2(
    finput in1, in2,
    foutput out1, out2
);
flow d1, d2, merged, incubated, out2_discard;

// meter in1 into droplets with nominal target volume 100
assign d1 = in1 % 100;
// meter in2 into droplets with nominal target volume 200
assign d2 = in2 % 200;

// merge the two droplet streams
assign merged = d1 + d2;

#MAP "MIXER" "~"
assign incubated = ~merged;

// ASSUMPTION: no split ratio specified; using equal split for kept/discard
assign out2_discard = incubated / 2;
assign out2 = out2_discard;
assign out1 = incubated - out2;
endmodule