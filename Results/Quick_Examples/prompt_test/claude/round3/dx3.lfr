module dx3(
    finput in1, in2, in3,
    foutput out1, out2
);
flow d1, da, db, mix1, mix2;

// meter in1 into droplets with nominal target volume 100
assign d1 = in1 % 100;

// equal split of droplets into two daughter streams
assign da = d1 / 2;
assign db = d1 / 2;

#MAP "MIXER" "~"
assign mix1 = ~(da + in2);
assign out1 = mix1;

#MAP "MIXER" "~"
assign mix2 = ~(db + in3);
assign out2 = mix2;
endmodule