PORT port_9 componentSpacing=2000.0 portRadius=1000.0 depth=1100.0 ;
PORT port_10 componentSpacing=2000.0 portRadius=1000.0 depth=1100.0 ;



CHANNEL channel_1 from port_4 1 to port_1 1 RoundedChannel=1 length=1000.0 minChannelLength=1000.0 connectionSpacing=1000 channelWidth=600 width=600  ;
